{% extends 'account/layout.html.twig' %}

{% block title %}Nouveau devis{% endblock %}

{% block content %}
    <div class="bg-white shadow rounded-lg p-6">
        <div class="sm:flex sm:items-center">
            <div class="sm:flex-auto">
                <h1 class="text-2xl font-bold mb-6">Créer un nouveau devis</h1>
            </div>
        </div>

        <div class="mt-8">
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                <div class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        {{ form_row(form.title, {
                            'label_attr': {'class': 'block text-sm font-medium text-gray-700'},
                            'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}
                        }) }}

                        {{ form_row(form.company, {
                            'label_attr': {'class': 'block text-sm font-medium text-gray-700'},
                            'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm'}
                        }) }}
                    </div>

                    {{ form_row(form.content, {
                        'label_attr': {'class': 'block text-sm font-medium text-gray-700'},
                        'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm h-32'}
                    }) }}

                    {{ form_row(form.isNegotiable, {
                        'label_attr': {'class': 'text-sm font-medium text-gray-700'},
                        'attr': {'class': 'rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 h-4 w-4'}
                    }) }}

                    {# Section Informations du destinataire #}

                </div>

                <div class="mt-8">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-lg font-medium text-gray-900">Lignes du devis</h2>
                        <button type="button" id="add-line" class="inline-flex items-center px-3 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
                            <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                            </svg>
                            Ajouter une ligne
                        </button>
                    </div>

                    <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
                        <table class="min-w-full divide-y divide-gray-300">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900">Titre</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Description</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Prix unitaire</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Quantité</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Total</th>
                                    <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                                        <span class="sr-only">Actions</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody id="devis-lines" class="divide-y divide-gray-200 bg-white">
                                <!-- Les lignes seront ajoutées ici dynamiquement -->
                            </tbody>
                            <tfoot>
                                <tr class="bg-gray-50">
                                    <td colspan="4" class="py-3.5 pl-4 pr-3 text-right text-sm font-semibold text-gray-900">Total du devis:</td>
                                    <td class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900" id="total-devis">0.00 €</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="mt-6 flex items-center justify-end space-x-4">
                    <a href="{{ path('app_devis_index') }}" class="text-sm font-medium text-gray-500 hover:text-gray-700">
                        Annuler
                    </a>
                    <button type="submit" class="inline-flex justify-center rounded-md border border-transparent bg-indigo-600 py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                        Créer le devis
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    let lineCount = 0;
    const devisLines = document.getElementById('devis-lines');
    const addLineButton = document.getElementById('add-line');
    const totalDevis = document.getElementById('total-devis');

    function updateTotal() {
        let total = 0;
        document.querySelectorAll('.line-total').forEach(lineTotal => {
            total += parseFloat(lineTotal.dataset.total || 0);
        });
        totalDevis.textContent = total.toFixed(2) + ' €';
    }

    function calculateLineTotal(row) {
        const quantity = parseFloat(row.querySelector('.quantity-input').value) || 0;
        const unitPrice = parseFloat(row.querySelector('.unit-price-input').value) || 0;
        const total = quantity * unitPrice;
        const totalElement = row.querySelector('.line-total');
        totalElement.textContent = total.toFixed(2) + ' €';
        totalElement.dataset.total = total;
        updateTotal();
    }

    function createDevisLine() {
        lineCount++;
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm">
                <input type="text" name="devis_assets[${lineCount}][name]" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" required>
            </td>
            <td class="whitespace-nowrap px-3 py-4 text-sm">
                <input type="text" name="devis_assets[${lineCount}][description]" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" required>
            </td>
            <td class="whitespace-nowrap px-3 py-4 text-sm">
                <input type="number" name="devis_assets[${lineCount}][unitPrice]" class="unit-price-input block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" step="0.01" required>
            </td>
            <td class="whitespace-nowrap px-3 py-4 text-sm">
                <input type="number" name="devis_assets[${lineCount}][size]" class="quantity-input block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" required>
            </td>
            <td class="whitespace-nowrap px-3 py-4 text-sm font-medium">
                <span class="line-total" data-total="0">0.00 €</span>
            </td>
            <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium">
                <button type="button" class="text-red-600 hover:text-red-900 delete-line">Supprimer</button>
            </td>
        `;

        const unitPriceInput = tr.querySelector('.unit-price-input');
        const quantityInput = tr.querySelector('.quantity-input');
        const deleteButton = tr.querySelector('.delete-line');

        [unitPriceInput, quantityInput].forEach(input => {
            input.addEventListener('input', () => calculateLineTotal(tr));
        });

        deleteButton.addEventListener('click', () => {
            tr.remove();
            updateTotal();
        });

        devisLines.appendChild(tr);
    }

    addLineButton.addEventListener('click', createDevisLine);
});
</script>
{% endblock %}
