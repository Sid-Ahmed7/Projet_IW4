{% if devis.state != 'Facturé' %}
    <form method="post" action="{{ path('app_devis_delete', {'id': devis.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce devis ?');" class="inline-block">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ devis.id) }}">
        <button class="text-red-600 hover:text-red-900 font-medium">Supprimer</button>
    </form>
{% endif %}
