{% extends 'account/layout.html.twig' %}

{% block title %}Liste des devis{% endblock %}

{% block content %}
<div class="container mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold">Liste des devis</h1>
        <a href="{{ path('app_devis_new') }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
            <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Nouveau devis
        </a>
    </div>

    {% if devis|length > 0 %}
        <div class="bg-white shadow-md rounded-lg overflow-hidden">
            <table class="min-w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Numéro</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Assignation</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Montant</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statut</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    {% for devi in devis %}
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">{{ devi.id }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ devi.createdAt|date('d/m/Y') }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ devi.client }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ devi.price }} €</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                    {% if devi.state == 'accepted' %}bg-green-100 text-green-800
                                    {% elseif devi.state == 'pending' %}bg-yellow-100 text-yellow-800
                                    {% else %}bg-gray-100 text-gray-800{% endif %}">
                                    {{ devi.state }}
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <div class="flex items-center space-x-3">
                                    <button onclick="showDevisDrawer({{ devi.id }})" class="text-indigo-600 hover:text-indigo-900 flex items-center">
                                        <svg class="h-5 w-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                        Détails
                                    </button>
                                    <div class="h-4 w-px bg-gray-300"></div>
                                    <a href="{{ path('app_devis_edit', {'id': devi.id}) }}" class="text-indigo-600 hover:text-indigo-900 flex items-center">
                                        <svg class="h-5 w-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                        Modifier
                                    </a>
                                    <div class="h-4 w-px bg-gray-300"></div>
                                    <a href="{{ path('app_devis_pdf', {'id': devi.id}) }}" class="text-indigo-600 hover:text-indigo-900 flex items-center">
                                        <svg class="h-5 w-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                        </svg>
                                        PDF
                                    </a>
                                </div>
                            </td>
                        </tr>

                        <!-- Drawer pour ce devis spécifique -->
                        <div id="devisDrawer{{ devi.id }}" class="fixed inset-0 overflow-hidden z-50 hidden">
                            <div class="absolute inset-0 overflow-hidden">
                                <div class="absolute inset-0 bg-gray-500 bg-opacity-75 transition-opacity" onclick="closeDevisDrawer({{ devi.id }})"></div>
                                
                                <div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10">
                                    <div class="pointer-events-auto w-screen max-w-2xl">
                                        <div class="flex h-full flex-col overflow-y-scroll bg-white py-6 shadow-xl">
                                            <div class="px-4 sm:px-6">
                                                <div class="flex items-start justify-between">
                                                    <h2 class="text-lg font-medium text-gray-900">Devis #{{ devi.id }}</h2>
                                                    <div class="ml-3 flex h-7 items-center">
                                                        <button onclick="closeDevisDrawer({{ devi.id }})" class="rounded-md bg-white text-gray-400 hover:text-gray-500">
                                                            <span class="sr-only">Fermer</span>
                                                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                                            </svg>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="relative mt-6 flex-1 px-4 sm:px-6">
                                                <div class="space-y-6">
                                                    <!-- En-tête du devis -->
                                                    <div class="border-b border-gray-200 pb-4">
                                                        <dl class="grid grid-cols-2 gap-4">
                                                            <div>
                                                                <dt class="text-sm font-medium text-gray-500">Client</dt>
                                                                <dd class="mt-1 text-sm text-gray-900">{{ devi.client }}</dd>
                                                            </div>
                                                            <div>
                                                                <dt class="text-sm font-medium text-gray-500">Date de création</dt>
                                                                <dd class="mt-1 text-sm text-gray-900">{{ devi.createdAt|date('d/m/Y') }}</dd>
                                                            </div>
                                                            <div>
                                                                <dt class="text-sm font-medium text-gray-500">Montant</dt>
                                                                <dd class="mt-1 text-sm text-gray-900">{{ devi.price }} €</dd>
                                                            </div>
                                                            <div>
                                                                <dt class="text-sm font-medium text-gray-500">Statut</dt>
                                                                <dd class="mt-1">
                                                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                                                        {% if devi.state == 'accepted' %}bg-green-100 text-green-800
                                                                        {% elseif devi.state == 'pending' %}bg-yellow-100 text-yellow-800
                                                                        {% else %}bg-gray-100 text-gray-800{% endif %}">
                                                                        {{ devi.state }}
                                                                    </span>
                                                                </dd>
                                                            </div>
                                                        </dl>
                                                    </div>

                                                    <!-- Contenu du devis -->
                                                    <div>
                                                        <h3 class="text-lg font-medium text-gray-900">Détails</h3>
                                                        <div class="mt-4 bg-gray-50 p-4 rounded-md">
                                                            <p class="text-sm text-gray-500">{{ devi.content }}</p>
                                                        </div>
                                                    </div>

                                                    <!-- Actions -->
                                                    <div class="border-t border-gray-200 pt-4">
                                                        <div class="flex justify-end space-x-3">
                                                            <a href="{{ path('app_devis_edit', {'id': devi.id}) }}" 
                                                               class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                                                Modifier
                                                            </a>
                                                            <a href="{{ path('app_devis_pdf', {'id': devi.id}) }}" 
                                                               class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                                                Télécharger PDF
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="text-center py-8">
            <p class="text-gray-500">Aucun devis trouvé.</p>
            <a href="{{ path('app_devis_new') }}" class="mt-4 inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
                Créer un devis
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function showDevisDrawer(devisId) {
    // Fermer tous les autres drawers
    document.querySelectorAll('[id^="devisDrawer"]').forEach(drawer => {
        drawer.classList.add('hidden');
    });
    
    // Afficher le drawer spécifique
    document.getElementById(`devisDrawer${devisId}`).classList.remove('hidden');
}

function closeDevisDrawer(devisId) {
    document.getElementById(`devisDrawer${devisId}`).classList.add('hidden');
}
</script>
{% endblock %}
       