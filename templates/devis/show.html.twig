{% extends 'account/layout.html.twig' %}


{% block title %}Détails du devis
{% endblock %}

{% block content %}
	<div class="space-y-6">
		<div class="text-sm text-gray-500">Devis #{{ devi.id }}</div>

		<div
			class="estimate-page bg-white p-8 shadow rounded-lg">
			{# En-tête minimaliste #}
			<div class="flex justify-between items-start mb-6">
				<div class="text-sm">
					<div>Émis le :
						{{ devi.createdAt|date('d/m/Y') }}</div>
					{# <div>Valide jusqu'au : {{ devi.validUntil|date('d/m/Y') }}</div> #}
					<div class="mt-2">
						<span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium
																                        {% if devi.state == 'Facturé' %}
																                            bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-600/20
																                        {% elseif devi.state == 'Validé' %}
																                            bg-green-50 text-green-700 ring-1 ring-inset ring-green-600/20
																                        {% elseif devi.state == 'En attente de validation' or devi.state == 'En attente' %}
																                            bg-yellow-50 text-yellow-700 ring-1 ring-inset ring-yellow-600/20
																                        {% elseif devi.state == 'Rejeté' %}
																                            bg-red-50 text-red-700 ring-1 ring-inset ring-red-600/20
																                        {% else %}
																                            bg-gray-50 text-gray-700 ring-1 ring-inset ring-gray-600/20
																                        {% endif %}
																                    ">
							{{ devi.state }}
						</span>
						
						{# Message d'information selon le statut #}
						{% if devi.state == 'En attente de validation' %}
							<div class="mt-2 p-2 bg-yellow-50 rounded-md border border-yellow-200">
								<div class="flex items-center">
									<svg class="h-4 w-4 text-yellow-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
									</svg>
									<span class="text-sm text-yellow-800 font-medium">En attente de validation</span>
								</div>
								<p class="text-xs text-yellow-700 mt-1">Ce devis attend la validation de l'entreprise destinataire avant de pouvoir être payé.</p>
							</div>
						{% elseif devi.state == 'Validé' %}
							<div class="mt-2 p-2 bg-green-50 rounded-md border border-green-200">
								<div class="flex items-center">
									<svg class="h-4 w-4 text-green-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
									</svg>
									<span class="text-sm text-green-800 font-medium">Validé</span>
								</div>
								<p class="text-xs text-green-700 mt-1">Ce devis a été validé et peut maintenant être payé.</p>
							</div>
						{% elseif devi.state == 'Rejeté' %}
							<div class="mt-2 p-2 bg-red-50 rounded-md border border-red-200">
								<div class="flex items-center">
									<svg class="h-4 w-4 text-red-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
									</svg>
									<span class="text-sm text-red-800 font-medium">Rejeté</span>
								</div>
								<p class="text-xs text-red-700 mt-1">Ce devis a été rejeté. Vous pouvez le modifier et le soumettre à nouveau.</p>
							</div>
						{% elseif devi.state == 'Facturé' %}
							<div class="mt-2 p-2 bg-blue-50 rounded-md border border-blue-200">
								<div class="flex items-center">
									<svg class="h-4 w-4 text-blue-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
									</svg>
									<span class="text-sm text-blue-800 font-medium">Facturé</span>
								</div>
								<p class="text-xs text-blue-700 mt-1">Ce devis a été transformé en facture.</p>
							</div>
						{% endif %}
					</div>
				</div>
				{% if devi.state != 'Facturé' %}
					<div>
						<a href="{{ path('app_invoice_new_from_devis', {'id': devi.id}) }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 shadow-sm">
							<svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
							</svg>
							Générer une facture
						</a>
					</div>
				{% endif %}
			</div>

			{# Coordonnées #}
			<div class="flex justify-between mb-8 text-sm">
				<div>
					<div class="font-medium text-gray-500 text-xs uppercase tracking-wide mb-2">Émetteur</div>
					{% if devi.hubuser and devi.hubuser.companies|length > 0 %}
						{% set emitterCompany = devi.hubuser.companies.first %}
						<div class="font-medium">{{ emitterCompany.name }}</div>
						<div>{{ emitterCompany.address }}</div>
						<div>{{ emitterCompany.email }}</div>
						<div>{{ emitterCompany.phoneNumber }}</div>
					{% else %}
						{# Fallback vers l'utilisateur si pas d'entreprise #}
						<div class="font-medium">{{ devi.hubuser.firstname }} {{ devi.hubuser.lastname }}</div>
						<div>{{ devi.hubuser.email }}</div>
					{% endif %}
				</div>
				<div class="text-right">
					<div class="font-medium text-gray-500 text-xs uppercase tracking-wide mb-2">Destinataire</div>
					{% if devi.company %}
						<div class="font-medium">{{ devi.company.name }}</div>
						<div>{{ devi.company.address }}</div>
						<div>{{ devi.company.email }}</div>
						<div>{{ devi.company.phoneNumber }}</div>
					{% else %}
						<div class="text-gray-500 italic">Destinataire non renseigné</div>
					{% endif %}
				</div>
			</div>

			{# Description du devis #}
			<div class="mb-8">
				<h3 class="text-lg font-medium text-gray-900 mb-2">{{ devi.title }}</h3>
				<p class="text-sm text-gray-600">{{ devi.content }}</p>
			</div>

			{# Tableau des items #}
			<div class="overflow-x-auto">
				<table class="min-w-full divide-y divide-gray-200">
					<thead class="bg-gray-50">
						<tr>
							<th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
							<th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Qté</th>
							<th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">PU (€)</th>
							<th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Total (€)</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						{% for asset in assets %}
							<tr>
								<td class="px-6 py-4 whitespace-nowrap">
									<div class="text-sm font-medium text-gray-900">{{ asset.name }}</div>
									<div class="text-sm text-gray-500">{{ asset.description }}</div>
								</td>
								<td class="px-6 py-4 whitespace-nowrap text-right text-sm text-gray-500">
									{{ asset.size }}
								</td>
								<td class="px-6 py-4 whitespace-nowrap text-right text-sm text-gray-500">
									{{ asset.unitPrice|number_format(2, ',', ' ') }}
								</td>
								<td class="px-6 py-4 whitespace-nowrap text-right text-sm text-gray-500">
									{{ asset.price|number_format(2, ',', ' ') }}
								</td>
							</tr>
						{% endfor %}
					</tbody>
					<tfoot class="bg-gray-50">
						<tr>
							<td colspan="3" class="px-6 py-4 text-right text-sm font-medium text-gray-900">Total HT</td>
							<td class="px-6 py-4 text-right text-sm font-medium text-gray-900">{{ devi.price|number_format(2, ',', ' ') }}
								€</td>
						</tr>
						<tr>
							<td colspan="3" class="px-6 py-4 text-right text-sm font-medium text-gray-900">TVA (20%)</td>
							<td class="px-6 py-4 text-right text-sm font-medium text-gray-900">{{ (devi.price * 0.2)|number_format(2, ',', ' ') }}
								€</td>
						</tr>
						<tr class="bg-gray-100">
							<td colspan="3" class="px-6 py-4 text-right text-sm font-bold text-gray-900">Total TTC</td>
							<td class="px-6 py-4 text-right text-sm font-bold text-gray-900">{{ (devi.price * 1.2)|number_format(2, ',', ' ') }}
								€</td>
						</tr>
					</tfoot>
				</table>
			</div>

			{# Termes et conditions #}
			<div class="mt-8 text-sm text-gray-600">
				<h3 class="font-medium mb-2">Termes et conditions</h3>
				<p>Les paiements doivent être effectués dans les délais spécifiés. Les paiements tardifs peuvent entraîner des frais supplémentaires.</p>
			</div>

			{# Information sur le workflow de validation #}
			{% if devi.state == 'En attente de validation' and devi.company %}
				<div class="mt-6 p-4 bg-blue-50 rounded-lg border border-blue-200">
					<h4 class="font-medium text-blue-900 mb-2">🔄 Workflow de validation</h4>
					<div class="text-sm text-blue-800 space-y-1">
						<p><strong>Étape actuelle :</strong> En attente de validation par {{ devi.company.name }}</p>
						<p><strong>Qui peut valider :</strong> Les membres de l'entreprise destinataire</p>
						<p><strong>Prochaine étape :</strong> Une fois validé, le paiement sera possible</p>
					</div>
				</div>
			{% endif %}

			{# Zone de validation pour l'entreprise destinataire - UNIQUEMENT si en attente de validation #}
			{% if devi.company and app.user.accountType == 'company' and devi.state == 'En attente de validation' %}
				{% set userCanValidate = false %}
				{% for userCompany in app.user.companies %}
					{% if userCompany.id == devi.company.id %}
						{% set userCanValidate = true %}
					{% endif %}
				{% endfor %}
				
				{% if userCanValidate %}
					{# Zone de validation centrée et mise en évidence #}
					<div class="mt-8 w-full flex justify-center">
						<div class="flex space-x-4 p-6 bg-gray-50 rounded-lg border border-gray-200">
							<form method="post" action="{{ path('app_devis_validate', {'id': devi.id}) }}" style="display: inline;">
								<input type="hidden" name="_token" value="{{ csrf_token('validate' ~ devi.id) }}">
								<button type="submit" class="inline-flex items-center px-8 py-4 border border-transparent text-base font-semibold rounded-md text-white bg-green hover:bg-green shadow-lg transition-all duration-200 transform hover:scale-105" onclick="return confirm('Êtes-vous sûr de vouloir valider ce devis ?')">
									<svg class="-ml-1 mr-3 h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
									</svg>
									Valider le devis
								</button>
							</form>
							<form method="post" action="{{ path('app_devis_reject', {'id': devi.id}) }}" style="display: inline;">
								<input type="hidden" name="_token" value="{{ csrf_token('reject' ~ devi.id) }}">
								<button type="submit" class="inline-flex items-center px-8 py-4 border border-transparent text-base font-semibold rounded-md text-white bg-red hover:bg-red shadow-lg transition-all duration-200 transform hover:scale-105" onclick="return confirm('Êtes-vous sûr de vouloir rejeter ce devis ?')">
									<svg class="-ml-1 mr-3 h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
									</svg>
									Rejeter le devis
								</button>
							</form>
						</div>
					</div>
				{% else %}
					{# Message informatif si l'utilisateur ne peut pas valider #}
					<div class="mt-8 w-full flex justify-center">
						<div class="p-4 bg-yellow-50 rounded-lg border border-yellow-200 text-center">
							<span class="text-sm text-yellow-800">⚠️ Seule l'entreprise destinataire peut valider ce devis</span>
						</div>
					</div>
				{% endif %}
			{% endif %}

			{# Actions secondaires - autres boutons #}
			<div class="mt-8 flex justify-end space-x-3 flex-wrap gap-2">
				<a href="{{ path('app_devis_edit', {'id': devi.id}) }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-gray-600 hover:bg-gray-700 shadow-sm transition-colors">
					<svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
					</svg>
					Modifier
				</a>
				<a href="{{ path('app_devis_recalculate', {'id': devi.id}) }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition-colors">
					<svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
					</svg>
					Recalculer
				</a>

				<a href="{{ path('app_devis_pdf', {'id': devi.id}) }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 shadow-sm transition-colors">
					<svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
					</svg>
					Télécharger PDF
				</a>

				{% if devi.state == 'Validé' and context != 'company' %}
					<a href="{{ path('stripe_devis_payment', {'id': devi.id}) }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-purple-600 hover:bg-purple-700 shadow-sm transition-colors">
						<svg class="-ml-1 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
						</svg>
						Payer
					</a>
				{% endif %}

				{% if devi.company and devi.state != 'Facturé' %}
					{% if context == 'company' and devi.company %}
						<a href="{{ path('app_devis_reminder', {'id': devi.id}) }}" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-yellow-500 hover:bg-yellow-600 transition-colors">
							Relancer par e-mail
						</a>
					{% endif %}
					{% if devi.state != 'Facturé' and context == 'company' and devi.paymentToken %}
						<a href="{{ path('stripe_send_payment_link', { id: devi.id }) }}" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 transition-colors">
							Envoyer le lien de paiement
						</a>
						<input type="text" id="paymentLinkInput" value="{{ url('stripe_public_payment', { token: devi.paymentToken }) }}" class="sr-only" readonly>
					{% endif %}
				{% endif %}
			</div>
		</div>
	</div>
	{% block javascripts %}
		{{ parent() }}
		 <script>
				    function copyPaymentLink() {
				        const input = document.getElementById("paymentLinkInput");
				        input.type = 'text'; // temporairement visible
				        input.select();
				        input.setSelectionRange(0, 99999); // pour mobile
				
				        document.execCommand("copy");
				        input.type = 'hidden';
				
				        alert("Lien copié : " + input.value);
				    }
				</script>
	{% endblock %}

{% endblock %}
