{% extends 'account/layout.html.twig' %}

{% block title %}Détails du devis{% endblock %}

{% block content %}
    <div class="space-y-6">
        <div>
            <h3 class="text-lg font-medium text-gray-900">Informations générales</h3>
            <dl class="mt-4 space-y-4">
                <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-gray-500">Numéro</dt>
                    <dd class="mt-1 text-sm text-gray-900">#{{ devi.id }}</dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-gray-500">Date de création</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ devi.createdAt|date('d/m/Y') }}</dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-gray-500">Client</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ devi.company ? devi.company.name : 'N/A' }}</dd>
                </div>
                <div class="sm:col-span-1">
                    <dt class="text-sm font-medium text-gray-500">État</dt>
                    <dd class="mt-1">
                        <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium
                            {% if devi.state == 'accepted' %}
                                bg-green-50 text-green-700 ring-1 ring-inset ring-green-600/20
                            {% elseif devi.state == 'pending' %}
                                bg-yellow-50 text-yellow-700 ring-1 ring-inset ring-yellow-600/20
                            {% else %}
                                bg-red-50 text-red-700 ring-1 ring-inset ring-red-600/20
                            {% endif %}
                        ">
                            {{ devi.state }}
                        </span>
                    </dd>
                </div>
                <div class="sm:col-span-2">
                    <dt class="text-sm font-medium text-gray-500">Description</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ devi.content }}</dd>
                </div>
            </dl>
        </div>

        <div>
            <h3 class="text-lg font-medium text-gray-900">Lignes du devis</h3>
            <div class="mt-4 flow-root">
                <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
                    <div class="inline-block min-w-full py-2 align-middle">
                        <table class="min-w-full divide-y divide-gray-300">
                            <thead>
                                <tr>
                                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900">Titre</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Description</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Prix unitaire</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Quantité</th>
                                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Total</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                                {% for asset in assets %}
                                    <tr>
                                        <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-gray-900">{{ asset.name }}</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{ asset.description }}</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{ asset.unitPrice }} €</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{ asset.size }}</td>
                                        <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{ asset.price }} €</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="py-3.5 pl-4 pr-3 text-right text-sm font-semibold text-gray-900">Total:</td>
                                    <td class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">{{ devi.price }} €</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex justify-end space-x-3">
            <a href="{{ path('app_devis_edit', {'id': devi.id}) }}" class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                Modifier
            </a>
            <a href="{{ path('app_devis_pdf', {'id': devi.id}) }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
                Télécharger PDF
            </a>
        </div>
    </div>
{% endblock %}
