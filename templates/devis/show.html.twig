{% extends 'account/layout.html.twig' %}

{% block title %}Détails du devis{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="text-sm text-gray-500">Devis #{{ devi.id }}</div>

    <div class="estimate-page bg-white p-8 shadow rounded-lg">
        {# En-tête minimaliste #}
        <div class="flex justify-between items-start mb-6">
            <div class="text-sm">
                <div>Émis le : {{ devi.createdAt|date('d/m/Y') }}</div>
                {# <div>Valide jusqu'au : {{ devi.validUntil|date('d/m/Y') }}</div> #}
                <div class="mt-2">
                    <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium
                        {% if devi.state == 'accepted' %}
                            bg-green-50 text-green-700 ring-1 ring-inset ring-green-600/20
                        {% elseif devi.state == 'pending' %}
                            bg-yellow-50 text-yellow-700 ring-1 ring-inset ring-yellow-600/20
                        {% else %}
                            bg-red-50 text-red-700 ring-1 ring-inset ring-red-600/20
                        {% endif %}
                    ">
                        {{ devi.state }}
                    </span>
                </div>
            </div>
        </div>

        {# Coordonnées #}
        <div class="flex justify-between mb-8 text-sm">
            <div>
                <div class="font-medium">{{ app.user.company.name }}</div>
                <div>{{ app.user.company.address }}</div>
                <div>{{ app.user.email }}</div>
                {# <div>{{ app.user.company.phone }}</div> #}
            </div>
            <div class="text-right">
                <div class="font-medium">{{ devi.company ? devi.company.name : 'N/A' }}</div>
                <div>{{ devi.company ? devi.company.address : '' }}</div>
            </div>
        </div>

        {# Description du devis #}
        <div class="mb-8">
            <h3 class="text-lg font-medium text-gray-900 mb-2">{{ devi.title }}</h3>
            <p class="text-sm text-gray-600">{{ devi.content }}</p>
        </div>

        {# Tableau des items #}
        <div class="overflow-hidden">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-gray-200">
                        <th class="py-2 text-left">Description</th>
                        <th class="py-2 text-right">Qté</th>
                        <th class="py-2 text-right">PU (€)</th>
                        <th class="py-2 text-right">Total (€)</th>
                    </tr>
                </thead>
                <tbody>
                    {% for asset in assets %}
                        <tr class="border-b border-gray-100">
                            <td class="py-3">
                                <div class="font-medium">{{ asset.name }}</div>
                                <div class="text-gray-500 text-xs">{{ asset.description }}</div>
                            </td>
                            <td class="py-3 text-right">{{ asset.size }}</td>
                            <td class="py-3 text-right">{{ asset.unitPrice|number_format(2, ',', ' ') }}</td>
                            <td class="py-3 text-right">{{ asset.price|number_format(2, ',', ' ') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="py-3 text-right font-medium">Total HT</td>
                        <td class="py-3 text-right">{{ devi.price|number_format(2, ',', ' ') }} €</td>
                    </tr>
                    <tr>
                        <td colspan="3" class="py-3 text-right font-medium">TVA (20%)</td>
                        <td class="py-3 text-right">{{ (devi.price * 0.2)|number_format(2, ',', ' ') }} €</td>
                    </tr>
                    <tr class="border-t border-gray-200">
                        <td colspan="3" class="py-3 text-right font-bold">Total TTC</td>
                        <td class="py-3 text-right font-bold">{{ (devi.price * 1.2)|number_format(2, ',', ' ') }} €</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        {# Termes et conditions #}
        <div class="mt-8 text-sm text-gray-600">
            <h3 class="font-medium mb-2">Termes et conditions</h3>
            <p>Les paiements doivent être effectués dans les délais spécifiés. Les paiements tardifs peuvent entraîner des frais supplémentaires.</p>
        </div>

        {# Actions #}
        <div class="mt-8 flex justify-end space-x-3">
            <a href="{{ path('app_devis_edit', {'id': devi.id}) }}" class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
                Modifier
            </a>
            <a href="{{ path('app_devis_pdf', {'id': devi.id}) }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700">
                Télécharger PDF
            </a>
            {% if devi.state != 'accepted' %}
                {# <form method="post" action="{{ path('app_devis_accept', {'id': devi.id}) }}" class="inline">
                    <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700">
                        Accepter le devis
                    </button>
                </form> #}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
