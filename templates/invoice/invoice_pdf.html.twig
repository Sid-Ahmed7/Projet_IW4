{# templates/invoice/invoice_pdf.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Facture #{{ invo.number }}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
        }
        .header {
            margin-bottom: 30px;
        }
        .company-info {
            margin-bottom: 30px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        th, td {
            padding: 10px;
            border: 1px solid #ddd;
            text-align: left;
        }
        th {
            background-color: #f8f9fa;
        }
        .total {
            font-weight: bold;
            font-size: 1.2em;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Facture #{{ invo.number }}</h1>
        <p>Date : {{ invo.createdAt|date('d/m/Y') }}</p>
    </div>

    <div class="company-info">
        <h2>Informations client</h2>
        {% if invo.company %}
            <p>{{ invo.company.name }}</p>
            <p>{{ invo.company.address }}</p>
            <p>SIRET : {{ invo.company.siretNumber }}</p>
        {% else %}
            <p>Client non renseigné</p>
        {% endif %}
    </div>

    <table>
        <tbody>
            <tr>
                <th>Statut du paiement</th>
                <td>
                    {% if invo.status == 'paid' %}Payé
                    {% elseif invo.status == 'pending' %}En attente de paiement
                    {% else %}Non payé{% endif %}
                </td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ invo.description }}</td>
            </tr>
            <tr>
                <th>Montant</th>
                <td>{{ invo.amount }} €</td>
            </tr>
        </tbody>
    </table>

    <div class="total">
        <p>Total : {{ invo.amount }} €</p>
    </div>
</body>
</html>
