<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Facture #{{ invoice.number }}</title>
  <style>
    body {
      font-family: 'Arial', sans-serif;
      font-size: 14px;
      color: #111827;
      padding: 2rem;
    }
    h1 {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }
    .text-right {
      text-align: right;
    }
    .text-gray-500 {
      color: #6B7280;
    }
    .font-bold {
      font-weight: bold;
    }
    .border {
      border: 1px solid #D1D5DB;
    }
    .rounded {
      border-radius: 0.375rem;
    }
    .p-4 {
      padding: 1rem;
    }
    .mb-2 {
      margin-bottom: 0.5rem;
    }
    .mb-4 {
      margin-bottom: 1rem;
    }
    .mb-6 {
      margin-bottom: 1.5rem;
    }
    .table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 1.5rem;
    }
    .table th, .table td {
      border: 1px solid #D1D5DB;
      padding: 0.5rem;
      text-align: left;
    }
    .bg-gray-100 {
      background-color: #F3F4F6;
    }
  </style>
</head>
<body>

  <div class="mb-6">
    <h1>Facture #{{ invoice.number }}</h1>
    <p class="text-gray-500">Date : {{ invoice.createdAt|date('d/m/Y') }}</p>
  </div>

  <div class="mb-6">
    <div class="mb-2">
      <span class="font-bold">Émetteur :</span><br>
      {% if invoice.hubuser and invoice.hubuser.companies|length > 0 %}
        {% set emitterCompany = invoice.hubuser.companies.first %}
        {{ emitterCompany.name }}<br>
        {{ emitterCompany.address }}<br>
        {{ emitterCompany.email }}<br>
        {{ emitterCompany.phoneNumber }}
      {% else %}
        {# Fallback vers l'utilisateur si pas d'entreprise #}
        {{ invoice.hubuser.firstname }} {{ invoice.hubuser.lastname }}<br>
        {{ invoice.hubuser.email }}
      {% endif %}
    </div>

    {% if invoice.company %}
      <div>
        <span class="font-bold">Destinataire :</span><br>
        {{ invoice.company.name }}<br>
        {{ invoice.company.address }}<br>
        {{ invoice.company.email }}
      </div>
    {% endif %}
  </div>

  <div class="mb-6">
    <span class="font-bold">Objet :</span>
    <p>{{ invoice.description }}</p>
  </div>

  <table class="table">
    <thead class="bg-gray-100">
      <tr>
        <th>Description</th>
        <th class="text-right">Montant (€)</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>{{ invoice.devis.title }}</td>
        <td class="text-right">{{ invoice.amount|number_format(2, ',', ' ') }}</td>
      </tr>
    </tbody>
    <tfoot class="bg-gray-100">
      <tr>
        <td class="font-bold text-right">Total HT</td>
        <td class="text-right">{{ invoice.amount|number_format(2, ',', ' ') }} €</td>
      </tr>
      <tr>
        <td class="font-bold text-right">TVA (20%)</td>
        <td class="text-right">{{ (invoice.amount * 0.2)|number_format(2, ',', ' ') }} €</td>
      </tr>
      <tr>
        <td class="font-bold text-right">Total TTC</td>
        <td class="text-right">{{ (invoice.amount * 1.2)|number_format(2, ',', ' ') }} €</td>
      </tr>
    </tfoot>
  </table>

  <p class="text-sm text-gray-500">Merci pour votre confiance.</p>

</body>
</html>
