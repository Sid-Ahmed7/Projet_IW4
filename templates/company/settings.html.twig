{% extends 'base.html.twig' %}

{% block title %}Paramètres {{ company.name }}{% endblock %}

{% block body %}
    {% include 'partials/admin/sidebare.html.twig' %}

    <main class="w-full md:w-[calc(100%-256px)] md:ml-64 bg-gray-100 min-h-screen transition-all main">
        {% include 'partials/admin/header.html.twig' %}

        <div class="p-6">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="bg-white border border-gray-100 shadow-md shadow-black/5 p-6 rounded-md">
                    <div class="flex justify-between mb-4 items-center">
                        <div class="font-medium">Informations de l'entreprise</div>
                        <button class="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 text-sm">
                            Modifier
                        </button>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Nom de l'entreprise</label>
                            <div class="text-gray-900">{{ company.name }}</div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Adresse</label>
                            <div class="text-gray-900">{{ company.address }}</div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Téléphone</label>
                            <div class="text-gray-900">{{ company.phoneNumber }}</div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                            <div class="text-gray-900">{{ company.email }}</div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">SIRET</label>
                            <div class="text-gray-900">{{ company.siretNumber }}</div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Logo</label>
                            {% if company.logo %}
                                <img src="{{ company.logo }}" alt="Logo" class="h-16 w-auto">
                            {% else %}
                                <div class="text-gray-500">Aucun logo</div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="bg-white border border-gray-100 shadow-md shadow-black/5 p-6 rounded-md">
                    <div class="flex justify-between mb-4 items-center">
                        <div class="font-medium">Catégories</div>
                        <button class="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 text-sm">
                            Ajouter une catégorie
                        </button>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full min-w-[540px]">
                            <thead>
                                <tr>
                                    <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left rounded-tl-md rounded-bl-md">Nom</th>
                                    <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left">Description</th>
                                    <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left rounded-tr-md rounded-br-md">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for category in company.categories %}
                                    <tr>
                                        <td class="py-2 px-4 border-b border-b-gray-50">
                                            <span class="text-[13px] font-medium text-gray-900">{{ category.name }}</span>
                                        </td>
                                        <td class="py-2 px-4 border-b border-b-gray-50">
                                            <span class="text-[13px] text-gray-900">{{ category.description }}</span>
                                        </td>
                                        <td class="py-2 px-4 border-b border-b-gray-50">
                                            <div class="flex items-center gap-2">
                                                <button class="text-gray-500 hover:text-gray-900">
                                                    <i class="bx bx-edit text-lg"></i>
                                                </button>
                                                <button class="text-gray-500 hover:text-red-500">
                                                    <i class="bx bx-trash text-lg"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="3" class="py-4 px-4 text-center text-gray-500">Aucune catégorie</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %} 