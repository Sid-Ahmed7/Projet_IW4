{% extends 'base.html.twig' %}

{% block title %}Demandes {{ company.name }}{% endblock %}

{% block body %}
    {% include 'partials/admin/sidebare.html.twig' %}

    <main class="w-full md:w-[calc(100%-256px)] md:ml-64 bg-gray-100 min-h-screen transition-all main">
        

        <div class="p-6">
            <div class="bg-white border border-gray-100 shadow-md shadow-black/5 p-6 rounded-md">
                <div class="flex justify-between mb-4 items-center">
                    <div class="font-medium text-lg">Demandes</div>
                    <div class="flex gap-4">
                        <select class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5">
                            <option value="">Tous les statuts</option>
                            <option value="pending">En attente</option>
                            <option value="accepted">Accepté</option>
                            <option value="rejected">Refusé</option>
                        </select>
                        <button class="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 text-sm">
                            Nouvelle demande
                        </button>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full min-w-[540px]">
                        <thead>
                            <tr>
                                <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left rounded-tl-md rounded-bl-md">Titre</th>
                                <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left">Client</th>
                                <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left">Prix</th>
                                <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left">Statut</th>
                                <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left">Date</th>
                                <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left rounded-tr-md rounded-br-md">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for devis in requests %}
                                <tr>
                                    <td class="py-2 px-4 border-b border-b-gray-50">
                                        <div class="flex items-center">
                                            <span class="text-[13px] font-medium text-gray-900">{{ devis.title }}</span>
                                        </div>
                                    </td>
                                    <td class="py-2 px-4 border-b border-b-gray-50">
                                        <span class="text-[13px] font-medium text-gray-900">{{ devis.user.firstname }} {{ devis.user.lastname }}</span>
                                    </td>
                                    <td class="py-2 px-4 border-b border-b-gray-50">
                                        <span class="text-[13px] font-medium text-gray-900">{{ devis.price }}€</span>
                                    </td>
                                    <td class="py-2 px-4 border-b border-b-gray-50">
                                        {% set statusClass = {
                                            'pending': 'bg-yellow-500',
                                            'accepted': 'bg-emerald-500',
                                            'rejected': 'bg-red-500'
                                        } %}
                                        <span class="inline-block text-[11px] font-semibold text-white {{ statusClass[devis.state]|default('bg-gray-500') }} px-2 py-1 rounded-full">
                                            {{ devis.state|capitalize }}
                                        </span>
                                    </td>
                                    <td class="py-2 px-4 border-b border-b-gray-50">
                                        <span class="text-[13px] font-medium text-gray-900">{{ devis.createdAt|date('d/m/Y') }}</span>
                                    </td>
                                    <td class="py-2 px-4 border-b border-b-gray-50">
                                        <div class="flex items-center gap-2">
                                            <a href="#" class="text-blue-500 hover:text-blue-600">
                                                <i class="bx bx-show text-lg"></i>
                                            </a>
                                            {% if devis.state == 'pending' %}
                                                <button class="text-emerald-500 hover:text-emerald-600">
                                                    <i class="bx bx-check text-lg"></i>
                                                </button>
                                                <button class="text-red-500 hover:text-red-600">
                                                    <i class="bx bx-x text-lg"></i>
                                                </button>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="py-4 px-4 text-center text-gray-500">Aucune demande</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
{% endblock %} 