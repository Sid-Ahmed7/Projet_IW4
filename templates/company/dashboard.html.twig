{% extends 'base.html.twig' %}

{% block title %}Dashboard {{ company.name }}{% endblock %}

{% block body %}
    {% include 'partials/admin/sidebare.html.twig' %}

    <main class="w-full md:w-[calc(100%-256px)] md:ml-64 bg-gray-100 min-h-screen transition-all main">
        

        <div class="p-6">
            <h1 class="text-3xl font-bold mb-8">Tableau de bord - {{ company.name }}</h1>
            
            <!-- Statistiques principales -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                <!-- Devis En Attente -->
                <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-sm font-medium text-gray-600">Devis En Attente</h3>
                        <div class="p-2 bg-yellow-100 rounded-lg">
                            <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="text-3xl font-bold text-gray-900 mb-2">{{ pending_devis|length }}</div>
                    <div class="text-sm text-orange-600 mb-3">Action requise</div>
                    <a href="{{ path('app_devis_index') }}" class="text-blue-600 hover:text-blue-800 text-sm font-medium">Traiter les devis</a>
                </div>

                <!-- Total Devis -->
                <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-sm font-medium text-gray-600">Total Devis</h3>
                        <div class="p-2 bg-blue-100 rounded-lg">
                            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="text-3xl font-bold text-gray-900 mb-2">{{ devis|length }}</div>
                    <div class="text-sm text-gray-500 mb-3">{{ accepted_devis|length }} acceptés</div>
                    <a href="{{ path('app_devis_index') }}" class="text-blue-600 hover:text-blue-800 text-sm font-medium">Voir tous les devis</a>
                </div>

                <!-- Revenus Potentiels -->
                <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-sm font-medium text-gray-600">Revenus Potentiels</h3>
                        <div class="p-2 bg-green-100 rounded-lg">
                            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="text-3xl font-bold text-gray-900 mb-2">{{ potential_revenue|number_format(0, ',', ' ') }}€</div>
                    <div class="text-sm text-gray-500 mb-3">Devis en cours + acceptés</div>
                    <span class="text-green-600 text-sm font-medium">{{ accepted_devis|length + finalized_devis|length }} devis</span>
                </div>

                <!-- Taux de Conversion -->
                <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-sm font-medium text-gray-600">Taux de Conversion</h3>
                        <div class="p-2 bg-purple-100 rounded-lg">
                            <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="text-3xl font-bold text-gray-900 mb-2">{{ conversion_rate }}%</div>
                    <div class="text-sm text-gray-500 mb-3">{{ finalized_devis|length }}/{{ devis|length }} finalisés</div>
                    <span class="text-purple-600 text-sm font-medium">Performance</span>
                </div>
            </div>

            <!-- Répartition des devis -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
                <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
                    <h3 class="text-lg font-semibold text-gray-900 mb-6">Répartition des devis</h3>
                    <div class="space-y-4">
                        <div class="flex items-center justify-between p-3 bg-yellow-50 rounded-lg">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-yellow-500 rounded-full mr-3"></div>
                                <span class="text-sm font-medium text-gray-700">En attente</span>
                            </div>
                            <span class="text-lg font-bold text-gray-900">{{ pending_devis|length }}</span>
                        </div>
                        <div class="flex items-center justify-between p-3 bg-green-50 rounded-lg">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-green-500 rounded-full mr-3"></div>
                                <span class="text-sm font-medium text-gray-700">Acceptés</span>
                            </div>
                            <span class="text-lg font-bold text-gray-900">{{ accepted_devis|length }}</span>
                        </div>
                        <div class="flex items-center justify-between p-3 bg-red-50 rounded-lg">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-red-500 rounded-full mr-3"></div>
                                <span class="text-sm font-medium text-gray-700">Refusés</span>
                            </div>
                            <span class="text-lg font-bold text-gray-900">{{ rejected_devis|length }}</span>
                        </div>
                        <div class="flex items-center justify-between p-3 bg-blue-50 rounded-lg">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-blue-500 rounded-full mr-3"></div>
                                <span class="text-sm font-medium text-gray-700">Finalisés</span>
                            </div>
                            <span class="text-lg font-bold text-gray-900">{{ finalized_devis|length }}</span>
                        </div>
                    </div>
                </div>

                <!-- Entreprises les plus actives -->
                <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
                    <h3 class="text-lg font-semibold text-gray-900 mb-6">Entreprises les plus actives</h3>
                    <div class="space-y-4">
                        {% for name, data in top_companies %}
                            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                                <div>
                                    <div class="font-semibold text-gray-900">{{ name }}</div>
                                    <div class="text-sm text-gray-500">{{ data.count }} devis</div>
                                </div>
                                <div class="text-right">
                                    <div class="font-bold text-lg text-gray-900">{{ data.total|number_format(0, ',', ' ') }}€</div>
                                    <div class="text-sm text-gray-500">total</div>
                                </div>
                            </div>
                        {% else %}
                            <div class="text-center py-8 text-gray-500">
                                <svg class="w-12 h-12 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                </svg>
                                <p>Aucune activité pour le moment</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
                <div class="bg-white border border-gray-100 shadow-md shadow-black/5 p-6 rounded-md">
                    <div class="flex justify-between mb-4 items-start">
                        <div class="font-medium">Dernières demandes</div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full min-w-[540px]">
                            <thead>
                                <tr>
                                    <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left rounded-tl-md rounded-bl-md">Titre</th>
                                    <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left">Statut</th>
                                    <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left">Date</th>
                                    <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left rounded-tr-md rounded-br-md">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for devis in company.devis|slice(0, 5) %}
                                    <tr>
                                        <td class="py-2 px-4 border-b border-b-gray-50">
                                            <div class="flex items-center">
                                                <span class="text-[13px] font-medium text-gray-900">{{ devis.title }}</span>
                                            </div>
                                        </td>
                                        <td class="py-2 px-4 border-b border-b-gray-50">
                                            <span class="text-[13px] font-medium text-gray-900">{{ devis.state }}</span>
                                        </td>
                                        <td class="py-2 px-4 border-b border-b-gray-50">
                                            <span class="text-[13px] font-medium text-gray-900">{{ devis.createdAt|date('d/m/Y') }}</span>
                                        </td>
                                        <td class="py-2 px-4 border-b border-b-gray-50">
                                            <a href="#" class="text-blue-500 hover:text-blue-600 text-[13px] font-medium">Voir</a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="py-4 px-4 text-center text-gray-500">Aucune demande</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="bg-white border border-gray-100 shadow-md shadow-black/5 p-6 rounded-md">
                    <div class="flex justify-between mb-4 items-start">
                        <div class="font-medium">Derniers membres</div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full min-w-[540px]">
                            <thead>
                                <tr>
                                    <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left rounded-tl-md rounded-bl-md">Nom</th>
                                    <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left">Email</th>
                                    <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left rounded-tr-md rounded-br-md">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for user in company.hubusers|slice(0, 5) %}
                                    <tr>
                                        <td class="py-2 px-4 border-b border-b-gray-50">
                                            <div class="flex items-center">
                                                {% if user.picture %}
                                                    <img src="{{ user.picture }}" alt="" class="w-8 h-8 rounded-full object-cover block">
                                                {% else %}
                                                    <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center">
                                                        <span class="text-sm font-medium text-gray-500">{{ user.firstname|first }}{{ user.lastname|first }}</span>
                                                    </div>
                                                {% endif %}
                                                <span class="text-[13px] font-medium text-gray-900 ml-2">{{ user.firstname }} {{ user.lastname }}</span>
                                            </div>
                                        </td>
                                        <td class="py-2 px-4 border-b border-b-gray-50">
                                            <span class="text-[13px] font-medium text-gray-900">{{ user.email }}</span>
                                        </td>
                                        <td class="py-2 px-4 border-b border-b-gray-50">
                                            <a href="#" class="text-blue-500 hover:text-blue-600 text-[13px] font-medium">Voir</a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="3" class="py-4 px-4 text-center text-gray-500">Aucun membre</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %} 