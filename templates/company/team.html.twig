{% extends 'base.html.twig' %}

{% block title %}Équipe {{ company.name }}{% endblock %}

{% block body %}
    {% include 'partials/admin/sidebare.html.twig' %}

    <main class="w-full md:w-[calc(100%-256px)] md:ml-64 bg-gray-100 min-h-screen transition-all main">
        {% include 'partials/admin/header.html.twig' %}

        <div class="p-6">
            <div class="bg-white border border-gray-100 shadow-md shadow-black/5 p-6 rounded-md">
                <div class="flex justify-between mb-4 items-center">
                    <div class="font-medium text-lg">Membres de l'équipe</div>
                    <button class="bg-blue-500 text-white px-4 py-2 rounded-md hover:bg-blue-600 text-sm">
                        Inviter un membre
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full min-w-[540px]">
                        <thead>
                            <tr>
                                <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left rounded-tl-md rounded-bl-md">Membre</th>
                                <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left">Email</th>
                                <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left">Rôle</th>
                                <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left">Statut</th>
                                <th class="text-[12px] uppercase tracking-wide font-medium text-gray-400 py-2 px-4 bg-gray-50 text-left rounded-tr-md rounded-br-md">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in team_members %}
                                <tr>
                                    <td class="py-2 px-4 border-b border-b-gray-50">
                                        <div class="flex items-center">
                                            {% if user.picture %}
                                                <img src="{{ user.picture }}" alt="" class="w-8 h-8 rounded-full object-cover block">
                                            {% else %}
                                                <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center">
                                                    <span class="text-sm font-medium text-gray-500">{{ user.firstname|first }}{{ user.lastname|first }}</span>
                                                </div>
                                            {% endif %}
                                            <span class="text-[13px] font-medium text-gray-900 ml-2">{{ user.firstname }} {{ user.lastname }}</span>
                                        </div>
                                    </td>
                                    <td class="py-2 px-4 border-b border-b-gray-50">
                                        <span class="text-[13px] font-medium text-gray-900">{{ user.email }}</span>
                                    </td>
                                    <td class="py-2 px-4 border-b border-b-gray-50">
                                        <span class="text-[13px] font-medium text-gray-900">
                                            {% if 'ROLE_ADMIN' in user.roles %}
                                                Administrateur
                                            {% else %}
                                                Membre
                                            {% endif %}
                                        </span>
                                    </td>
                                    <td class="py-2 px-4 border-b border-b-gray-50">
                                        <span class="inline-block text-[11px] font-semibold text-white bg-emerald-500 px-2 py-1 rounded-full">Actif</span>
                                    </td>
                                    <td class="py-2 px-4 border-b border-b-gray-50">
                                        <div class="flex items-center gap-2">
                                            <button class="text-gray-500 hover:text-gray-900">
                                                <i class="bx bx-edit text-lg"></i>
                                            </button>
                                            <button class="text-gray-500 hover:text-red-500">
                                                <i class="bx bx-trash text-lg"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="py-4 px-4 text-center text-gray-500">Aucun membre dans l'équipe</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
{% endblock %} 