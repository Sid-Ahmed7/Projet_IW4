{% extends 'layouts/app.html.twig' %}

{% block title %}Historique des transactions{% endblock %}

{% block content %}
<div class="bg-gradient-to-br from-blue-50 to-indigo-100 -mx-6 -my-8 p-8 min-h-screen">
        <!-- En-tête -->
        <div class="mb-8">
            <div class="flex items-center mb-6">
                <a href="{{ path('app_wallet_dashboard') }}" 
                   class="mr-4 p-2 rounded-lg bg-white shadow-md hover:shadow-lg transition-shadow">
                    <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                </a>
                <div>
                    <h1 class="text-3xl font-bold text-gray-900 mb-2">📊 Historique des transactions</h1>
                    <p class="text-gray-600">Consultez l'historique complet de votre portefeuille</p>
                </div>
            </div>
        </div>

        <div class="max-w-6xl mx-auto">
            {% if transactions is empty %}
                <!-- État vide -->
                <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-xl border border-white/20 p-12 text-center">
                    <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">Aucune transaction</h3>
                    <p class="text-gray-600 mb-6">Vos transactions apparaîtront ici une fois que vous commencerez à recevoir des paiements.</p>
                    <a href="{{ path('app_account_invoice_index') }}" 
                       class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-xl hover:from-blue-700 hover:to-blue-800 transition-all transform hover:scale-105 shadow-lg">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Créer une facture
                    </a>
                </div>
            {% else %}
                <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
                    <!-- Sidebar avec statistiques -->
                    <div class="lg:col-span-1">
                        <div class="space-y-6">
                            <!-- Solde actuel -->
                            <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-xl border border-white/20 p-6">
                                <h3 class="text-lg font-bold text-gray-900 mb-4">💼 Solde actuel</h3>
                                <div class="space-y-3">
                                    <div class="text-center p-4 bg-green-50 rounded-xl">
                                        <div class="text-2xl font-bold text-green-600">{{ wallet.balance|number_format(2, ',', ' ') }} €</div>
                                        <div class="text-sm text-green-700">Disponible</div>
                                    </div>
                                    <div class="text-center p-3 bg-orange-50 rounded-lg">
                                        <div class="text-lg font-semibold text-orange-600">{{ wallet.pendingBalance|number_format(2, ',', ' ') }} €</div>
                                        <div class="text-xs text-orange-700">En attente</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Statistiques rapides -->
                            <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-xl border border-white/20 p-6">
                                <h3 class="text-lg font-bold text-gray-900 mb-4">📈 Statistiques</h3>
                                <div class="space-y-3">
                                    <div class="flex justify-between items-center p-3 bg-blue-50 rounded-lg">
                                        <span class="text-sm text-gray-700">Total gains</span>
                                        <span class="font-semibold text-blue-600">{{ wallet.totalEarnings|number_format(2, ',', ' ') }} €</span>
                                    </div>
                                    <div class="flex justify-between items-center p-3 bg-red-50 rounded-lg">
                                        <span class="text-sm text-gray-700">Total retraits</span>
                                        <span class="font-semibold text-red-600">{{ wallet.totalWithdrawn|number_format(2, ',', ' ') }} €</span>
                                    </div>
                                    <div class="flex justify-between items-center p-3 bg-green-50 rounded-lg">
                                        <span class="text-sm text-gray-700">Nb transactions</span>
                                        <span class="font-semibold text-green-600">{{ transactions|length }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Liste des transactions -->
                    <div class="lg:col-span-3">
                        <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-xl border border-white/20 p-8">
                            <div class="flex justify-between items-center mb-6">
                                <h2 class="text-2xl font-bold text-gray-900">Transactions</h2>
                                <div class="text-sm text-gray-600">
                                    {{ transactions|length }} transaction(s)
                                </div>
                            </div>

                            <div class="space-y-4">
                                {% for transaction in transactions %}
                                    <div class="border border-gray-200 rounded-xl p-6 hover:shadow-md transition-shadow">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center">
                                                <!-- Icône selon le type -->
                                                <div class="mr-4 p-3 rounded-full 
                                                    {% if transaction.type == 'credit' %}
                                                        bg-green-100 text-green-600
                                                    {% else %}
                                                        bg-red-100 text-red-600
                                                    {% endif %}">
                                                    {% if transaction.type == 'credit' %}
                                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                                                        </svg>
                                                    {% else %}
                                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                                                        </svg>
                                                    {% endif %}
                                                </div>

                                                <div>
                                                    <div class="flex items-center gap-3 mb-1">
                                                        <h4 class="font-semibold text-gray-900">
                                                            {% if transaction.source == 'invoice_payment' %}
                                                                💰 Paiement de facture
                                                            {% elseif transaction.source == 'payout' %}
                                                                🏦 Retrait vers compte bancaire
                                                            {% elseif transaction.source == 'adjustment' %}
                                                                ⚙️ Ajustement administratif
                                                            {% else %}
                                                                📋 {{ transaction.source|title }}
                                                            {% endif %}
                                                        </h4>
                                                        
                                                        <!-- Badge du type -->
                                                        <span class="px-2 py-1 text-xs font-medium rounded-full
                                                            {% if transaction.type == 'credit' %}
                                                                bg-green-100 text-green-800
                                                            {% else %}
                                                                bg-red-100 text-red-800
                                                            {% endif %}">
                                                            {{ transaction.type == 'credit' ? 'Crédit' : 'Débit' }}
                                                        </span>
                                                    </div>
                                                    
                                                    <div class="text-sm text-gray-600">
                                                        {{ transaction.createdAt|date('d/m/Y à H:i') }}
                                                        {% if transaction.metadata %}
                                                            {% if transaction.metadata.invoice_id %}
                                                                • Facture #{{ transaction.metadata.invoice_id }}
                                                            {% endif %}
                                                            {% if transaction.metadata.payout_request_id %}
                                                                • Demande #{{ transaction.metadata.payout_request_id }}
                                                            {% endif %}
                                                        {% endif %}
                                                    </div>
                                                    
                                                    {% if transaction.description %}
                                                        <div class="text-sm text-gray-500 mt-1">
                                                            {{ transaction.description }}
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            </div>

                                            <!-- Montant -->
                                            <div class="text-right">
                                                <div class="text-xl font-bold
                                                    {% if transaction.type == 'credit' %}
                                                        text-green-600
                                                    {% else %}
                                                        text-red-600
                                                    {% endif %}">
                                                    {% if transaction.type == 'credit' %}+{% else %}-{% endif %}{{ transaction.amount|number_format(2, ',', ' ') }} €
                                                </div>
                                                
                                                {% if transaction.metadata %}
                                                    {% if transaction.metadata.balance_after %}
                                                        <div class="text-sm text-gray-500">
                                                            Solde: {{ transaction.metadata.balance_after|number_format(2, ',', ' ') }} €
                                                        </div>
                                                    {% endif %}
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
</div>
{% endblock %}
