{% extends 'layouts/app.html.twig' %}

{% block title %}Historique des Transactions{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8">
    <!-- En-tête -->
    <div class="flex items-center justify-between mb-8">
        <div class="flex items-center">
            <a href="{{ path('app_wallet_dashboard') }}" 
               class="text-blue-600 hover:text-blue-700 inline-flex items-center mr-4">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
                Retour
            </a>
            <h1 class="text-3xl font-bold text-gray-900">Historique des Transactions</h1>
        </div>
        
        <!-- Solde actuel -->
        <div class="bg-blue-50 border border-blue-200 px-4 py-2 rounded-lg">
            <p class="text-blue-900 font-medium">Solde: {{ wallet.balance|number_format(2, ',', ' ') }} €</p>
        </div>
    </div>

    {% if transactions is empty %}
        <!-- État vide -->
        <div class="bg-white rounded-xl shadow-lg p-12 text-center">
            <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Aucune transaction</h3>
            <p class="text-gray-600 mb-6">Vos transactions apparaîtront ici une fois que vous commencerez à recevoir des paiements.</p>
            <a href="{{ path('app_account_invoices') }}" 
               class="inline-flex items-center px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                Créer une facture
            </a>
        </div>
    {% else %}
        <!-- Liste des transactions -->
        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="text-left py-4 px-6 font-medium text-gray-700">Date</th>
                            <th class="text-left py-4 px-6 font-medium text-gray-700">Type</th>
                            <th class="text-left py-4 px-6 font-medium text-gray-700">Description</th>
                            <th class="text-right py-4 px-6 font-medium text-gray-700">Montant</th>
                            <th class="text-left py-4 px-6 font-medium text-gray-700">Référence</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for transaction in transactions %}
                            <tr class="hover:bg-gray-50 transition-colors">
                                <!-- Date -->
                                <td class="py-4 px-6">
                                    <div class="text-gray-900 font-medium">
                                        {{ transaction.createdAt|date('d/m/Y') }}
                                    </div>
                                    <div class="text-sm text-gray-500">
                                        {{ transaction.createdAt|date('H:i') }}
                                    </div>
                                </td>

                                <!-- Type avec icône -->
                                <td class="py-4 px-6">
                                    <div class="flex items-center">
                                        <div class="w-8 h-8 rounded-full flex items-center justify-center mr-3 
                                            {{ transaction.isCredit ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-600' }}">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                {% if transaction.isCredit %}
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                                {% else %}
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                                                {% endif %}
                                            </svg>
                                        </div>
                                        <div>
                                            <div class="font-medium text-gray-900">
                                                {{ transaction.typeLabel }}
                                            </div>
                                            <div class="text-sm text-gray-500">
                                                {{ transaction.sourceLabel }}
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- Description -->
                                <td class="py-4 px-6">
                                    <div class="text-gray-900">
                                        {% if transaction.description %}
                                            {{ transaction.description }}
                                        {% else %}
                                            <span class="text-gray-400 italic">Aucune description</span>
                                        {% endif %}
                                    </div>
                                    
                                    <!-- Informations supplémentaires pour les paiements de factures -->
                                    {% if transaction.invoice %}
                                        <div class="mt-1">
                                            <a href="{{ path('app_account_invoice_show', {id: transaction.invoice.id}) }}" 
                                               class="inline-flex items-center text-sm text-blue-600 hover:text-blue-700">
                                                <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                                </svg>
                                                Voir la facture
                                            </a>
                                        </div>
                                    {% endif %}
                                    
                                    <!-- Informations pour les retraits -->
                                    {% if transaction.payoutRequest %}
                                        <div class="mt-1 text-sm text-gray-500">
                                            <span class="font-medium">IBAN:</span> 
                                            {{ transaction.payoutRequest.iban[:4] }}****{{ transaction.payoutRequest.iban[-4:] }}
                                        </div>
                                    {% endif %}
                                </td>

                                <!-- Montant -->
                                <td class="py-4 px-6 text-right">
                                    <div class="font-bold text-lg {{ transaction.isCredit ? 'text-green-600' : 'text-red-600' }}">
                                        {{ transaction.isCredit ? '+' : '-' }}{{ transaction.amount|number_format(2, ',', ' ') }} €
                                    </div>
                                </td>

                                <!-- Référence externe -->
                                <td class="py-4 px-6">
                                    {% if transaction.externalReference %}
                                        <div class="text-sm text-gray-500 font-mono">
                                            {{ transaction.externalReference|slice(0, 16) }}...
                                        </div>
                                    {% else %}
                                        <span class="text-gray-400">-</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Résumé en bas -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mr-4">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Total des revenus</p>
                        <p class="text-xl font-bold text-green-600">{{ wallet.totalEarnings|number_format(2, ',', ' ') }} €</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center mr-4">
                        <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Total retiré</p>
                        <p class="text-xl font-bold text-red-600">{{ wallet.totalWithdrawn|number_format(2, ',', ' ') }} €</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center">
                    <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mr-4">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Solde actuel</p>
                        <p class="text-xl font-bold text-blue-600">{{ wallet.balance|number_format(2, ',', ' ') }} €</p>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
