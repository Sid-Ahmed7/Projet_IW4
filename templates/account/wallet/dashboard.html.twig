{% extends 'layouts/app.html.twig' %}

{% block title %}Mon Portefeuille
{% endblock %}

{% block content %}
	<div class="py-6">
		<div
			class="bg-gradient-to-br from-blue-50 to-indigo-100 -mx-6 -my-8 p-8 min-h-screen">
			<!-- En-tête avec solde principal -->
			<div class="mb-8">
				<div class="flex items-center justify-between mb-8">
					<div>
						<h1 class="text-4xl font-bold text-gray-900 mb-2">💰 Mon Portefeuille</h1>
						<p class="text-gray-600">Gérez vos gains et demandez vos retraits en toute sécurité</p>
					</div>
					<a href="{{ path('app_wallet_payout_request') }}" class="bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white px-8 py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl inline-flex items-center">
						<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
						</svg>
						Demander un retrait
					</a>
				</div>

				<!-- Cartes de solde améliorées -->
				<div
					class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
					<!-- Solde disponible -->
					<div class="relative bg-gradient-to-br from-emerald-500 via-emerald-600 to-emerald-700 text-white p-8 rounded-2xl shadow-2xl hover:shadow-3xl transition-all duration-300 transform hover:-translate-y-1">
						<div class="absolute top-0 right-0 w-32 h-32 bg-white bg-opacity-10 rounded-full -mr-16 -mt-16"></div>
						<div class="relative">
							<div class="flex items-center justify-between mb-4">
								<div class="bg-emerald-400 bg-opacity-30 p-3 rounded-xl backdrop-blur-sm">
									<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
									</svg>
								</div>
								<div class="text-emerald-100 text-sm font-medium uppercase tracking-wider">Disponible</div>
							</div>
							<div class="text-4xl font-bold mb-1">{{ wallet.balance|number_format(2, ',', ' ') }}
								€</div>
							<div class="text-emerald-200 text-sm">Prêt pour retrait</div>
						</div>
					</div>

					<!-- Solde en attente -->
					<div class="relative bg-gradient-to-br from-amber-500 via-orange-500 to-red-500 text-white p-8 rounded-2xl shadow-2xl hover:shadow-3xl transition-all duration-300 transform hover:-translate-y-1">
						<div class="absolute top-0 right-0 w-32 h-32 bg-white bg-opacity-10 rounded-full -mr-16 -mt-16"></div>
						<div class="relative">
							<div class="flex items-center justify-between mb-4">
								<div class="bg-orange-400 bg-opacity-30 p-3 rounded-xl backdrop-blur-sm">
									<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
									</svg>
								</div>
								<div class="text-orange-100 text-sm font-medium uppercase tracking-wider">En attente</div>
							</div>
							<div class="text-4xl font-bold mb-1">{{ wallet.pendingBalance|number_format(2, ',', ' ') }}
								€</div>
							<div class="text-orange-200 text-sm">En cours de traitement</div>
						</div>
					</div>

					<!-- Total des gains -->
					<div class="relative bg-gradient-to-br from-purple-600 via-blue-600 to-indigo-700 text-white p-8 rounded-2xl shadow-2xl hover:shadow-3xl transition-all duration-300 transform hover:-translate-y-1">
						<div class="absolute top-0 right-0 w-32 h-32 bg-white bg-opacity-10 rounded-full -mr-16 -mt-16"></div>
						<div class="relative">
							<div class="flex items-center justify-between mb-4">
								<div class="bg-blue-400 bg-opacity-30 p-3 rounded-xl backdrop-blur-sm">
									<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
									</svg>
								</div>
								<div class="text-blue-100 text-sm font-medium uppercase tracking-wider">Total gains</div>
							</div>
							<div class="text-4xl font-bold mb-1">{{ wallet.totalEarnings|number_format(2, ',', ' ') }}
								€</div>
							<div class="text-blue-200 text-sm">Depuis le début</div>
						</div>
					</div>
				</div>
			</div>

			<div
				class="grid grid-cols-1 xl:grid-cols-3 gap-8">
				<!-- Statistiques mensuelles - span 2 colonnes -->
				<div class="xl:col-span-2 bg-white/80 backdrop-blur-sm rounded-2xl shadow-xl border border-white/20 p-8">
					<div class="flex items-center justify-between mb-8">
						<div>
							<h2 class="text-2xl font-bold text-gray-900 mb-2">📊 Statistiques du Mois</h2>
							<p class="text-gray-600">Aperçu de vos performances mensuelles</p>
						</div>
						<a href="{{ path('app_wallet_stats') }}" class="text-blue-600 hover:text-blue-700 font-semibold bg-blue-50 hover:bg-blue-100 px-4 py-2 rounded-lg transition-colors">
							Voir détails →
						</a>
					</div>

					<div
						class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
						<!-- Revenus du mois -->
						<div class="bg-gradient-to-br from-green-50 to-emerald-100 p-6 rounded-xl border border-green-200">
							<div class="flex items-center justify-between mb-3">
								<div class="w-12 h-12 bg-green-500 rounded-xl flex items-center justify-center">
									<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11l5-5m0 0l5 5m-5-5v12"></path>
									</svg>
								</div>
								<span class="text-green-600 text-sm font-semibold">Revenus</span>
							</div>
							<div class="text-2xl font-bold text-green-700">+{{ monthlyStats.total_credits|number_format(2, ',', ' ') }}
								€</div>
							<div class="text-green-600 text-sm mt-1">Ce mois-ci</div>
						</div>

						<!-- Retraits du mois -->
						<div class="bg-gradient-to-br from-red-50 to-pink-100 p-6 rounded-xl border border-red-200">
							<div class="flex items-center justify-between mb-3">
								<div class="w-12 h-12 bg-red-500 rounded-xl flex items-center justify-center">
									<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 13l-5 5m0 0l-5-5m5 5V6"></path>
									</svg>
								</div>
								<span class="text-red-600 text-sm font-semibold">Retraits</span>
							</div>
							<div class="text-2xl font-bold text-red-700">-{{ monthlyStats.total_debits|number_format(2, ',', ' ') }}
								€</div>
							<div class="text-red-600 text-sm mt-1">Ce mois-ci</div>
						</div>

						<!-- Bénéfice net -->
						<div class="bg-gradient-to-br from-blue-50 to-indigo-100 p-6 rounded-xl border border-blue-200">
							<div class="flex items-center justify-between mb-3">
								<div class="w-12 h-12 bg-blue-500 rounded-xl flex items-center justify-center">
									<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
									</svg>
								</div>
								<span class="text-blue-600 text-sm font-semibold">Net</span>
							</div>
							<div class="text-2xl font-bold {{ monthlyStats.net_amount|number_format(2, '.', '') >= 0 ? 'text-blue-700' : 'text-red-700' }}">
								{{ monthlyStats.net_amount|number_format(2, ',', ' ') }}
								€
							</div>
							<div class="text-blue-600 text-sm mt-1">Bénéfice net</div>
						</div>
					</div>

					<!-- Actions rapides -->
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<a href="{{ path('app_wallet_transactions') }}" class="bg-gradient-to-r from-gray-50 to-gray-100 hover:from-gray-100 hover:to-gray-200 p-4 rounded-xl border border-gray-200 transition-all duration-300 group">
							<div class="flex items-center justify-between">
								<div class="flex items-center">
									<div class="w-10 h-10 bg-gray-500 rounded-lg flex items-center justify-center mr-3 group-hover:bg-gray-600 transition-colors">
										<svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
										</svg>
									</div>
									<div>
										<div class="font-semibold text-gray-900">Historique complet</div>
										<div class="text-sm text-gray-600">Voir toutes les transactions</div>
									</div>
								</div>
								<svg class="w-5 h-5 text-gray-400 group-hover:text-gray-600 transition-colors" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
								</svg>
							</div>
						</a>

						<a href="{{ path('app_wallet_stats') }}" class="bg-gradient-to-r from-blue-50 to-indigo-100 hover:from-blue-100 hover:to-indigo-200 p-4 rounded-xl border border-blue-200 transition-all duration-300 group">
							<div class="flex items-center justify-between">
								<div class="flex items-center">
									<div class="w-10 h-10 bg-blue-500 rounded-lg flex items-center justify-center mr-3 group-hover:bg-blue-600 transition-colors">
										<svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
										</svg>
									</div>
									<div>
										<div class="font-semibold text-gray-900">Statistiques avancées</div>
										<div class="text-sm text-gray-600">Analyses détaillées</div>
									</div>
								</div>
								<svg class="w-5 h-5 text-gray-400 group-hover:text-gray-600 transition-colors" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
								</svg>
							</div>
						</a>
					</div>
				</div>

				<!-- Dernières transactions -->
				<div class="bg-white/80 backdrop-blur-sm rounded-2xl shadow-xl border border-white/20 p-8">
					<div class="flex items-center justify-between mb-6">
						<div>
							<h2 class="text-xl font-bold text-gray-900 mb-1">🔄 Activité Récente</h2>
							<p class="text-gray-600 text-sm">Dernières transactions</p>
						</div>
						<a href="{{ path('app_wallet_transactions') }}" class="text-blue-600 hover:text-blue-700 font-medium text-sm">
							Voir tout →
						</a>
					</div>

					{% if transactions is empty %}
						<div class="text-center py-12">
							<div class="w-20 h-20 bg-gradient-to-br from-gray-100 to-gray-200 rounded-full flex items-center justify-center mx-auto mb-4">
								<svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
								</svg>
							</div>
							<h3 class="font-semibold text-gray-900 mb-2">Aucune transaction</h3>
							<p class="text-gray-500 text-sm mb-4">Vos transactions apparaîtront ici</p>
							<a href="{{ path('app_account_invoices') }}" class="text-blue-600 hover:text-blue-700 font-medium text-sm">
								Créer une facture →
							</a>
						</div>
					{% else %}
						<div class="space-y-4">
							{% for transaction in transactions %}
								<div class="group relative bg-gradient-to-r from-gray-50 to-white p-4 rounded-xl border border-gray-100 hover:border-gray-200 hover:shadow-md transition-all duration-300">
									<div class="flex items-center justify-between">
										<div class="flex items-center space-x-4">
											<div class="w-12 h-12 rounded-xl flex items-center justify-center {{ transaction.isCredit ? 'bg-gradient-to-br from-green-400 to-emerald-500' : 'bg-gradient-to-br from-red-400 to-pink-500' }} shadow-lg">
												<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewbox="0 0 24 24">
													{% if transaction.isCredit %}
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11l5-5m0 0l5 5m-5-5v12"></path>
													{% else %}
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 13l-5 5m0 0l-5-5m5 5V6"></path>
													{% endif %}
												</svg>
											</div>
											<div>
												<p class="font-semibold text-gray-900">{{ transaction.sourceLabel }}</p>
												<p class="text-sm text-gray-500">{{ transaction.createdAt|date('d/m/Y à H:i') }}</p>
												{% if transaction.description %}
													<p class="text-xs text-gray-400 mt-1">{{ transaction.description|slice(0, 40) }}...</p>
												{% endif %}
											</div>
										</div>
										<div class="text-right">
											<p class="font-bold text-lg {{ transaction.isCredit ? 'text-green-600' : 'text-red-600' }}">
												{{ transaction.isCredit ? '+' : '-' }}{{ transaction.amount|number_format(2, ',', ' ') }}
												€
											</p>
										</div>
									</div>
								</div>
							{% endfor %}
						</div>
					{% endif %}
				</div>
			</div>

			<!-- Demandes de retrait en cours -->
			{% if payoutRequests is not empty %}
				<div class="mt-8 bg-white/80 backdrop-blur-sm rounded-2xl shadow-xl border border-white/20 p-8">
					<div class="flex items-center justify-between mb-6">
						<div>
							<h2 class="text-2xl font-bold text-gray-900 mb-2">💸 Demandes de Retrait</h2>
							<p class="text-gray-600">Suivez l'état de vos demandes de retrait</p>
						</div>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
						{% for payoutRequest in payoutRequests %}
							<div class="bg-gradient-to-br from-white to-gray-50 p-6 rounded-xl border border-gray-200 hover:border-gray-300 hover:shadow-lg transition-all duration-300">
								<div class="flex items-center justify-between mb-4">
									<div class="text-2xl font-bold text-gray-900">
										{{ payoutRequest.amount|number_format(2, ',', ' ') }}
										€
									</div>
									<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold
											                                    {% if payoutRequest.status == 'pending' %}
											                                        bg-yellow-100 text-yellow-800 border border-yellow-200
											                                    {% elseif payoutRequest.status == 'processing' %}
											                                        bg-blue-100 text-blue-800 border border-blue-200
											                                    {% elseif payoutRequest.status == 'completed' %}
											                                        bg-green-100 text-green-800 border border-green-200
											                                    {% elseif payoutRequest.status == 'failed' %}
											                                        bg-red-100 text-red-800 border border-red-200
											                                    {% else %}
											                                        bg-gray-100 text-gray-800 border border-gray-200
											                                    {% endif %}">
										{{ payoutRequest.statusLabel }}
									</span>
								</div>

								<div class="space-y-2 mb-4">
									<div class="flex items-center text-sm text-gray-600">
										<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
										</svg>
										{{ payoutRequest.requestedAt|date('d/m/Y à H:i') }}
									</div>
									{% if payoutRequest.accountHolderName %}
										<div class="flex items-center text-sm text-gray-600">
											<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
											</svg>
											{{ payoutRequest.accountHolderName }}
										</div>
									{% endif %}
									<div class="flex items-center text-sm text-gray-600 font-mono">
										<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
										</svg>
										{{ payoutRequest.iban[:4] }}****{{ payoutRequest.iban[-4:] }}
									</div>
								</div>

								{% if payoutRequest.canBeCancelled %}
									<form method="post" action="{{ path('app_wallet_payout_cancel', {id: payoutRequest.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler cette demande ?')">
										<button type="submit" class="w-full bg-red-50 hover:bg-red-100 text-red-600 hover:text-red-700 px-4 py-2 rounded-lg font-medium transition-colors border border-red-200 hover:border-red-300">
											<svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewbox="0 0 24 24">
												<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
											</svg>
											Annuler la demande
										</button>
									</form>
								{% endif %}
							</div>
						{% endfor %}
					</div>
				</div>
			{% endif %}
		</div>
    </div>
	{% endblock %}
