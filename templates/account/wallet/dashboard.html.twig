{% extends 'layouts/app.html.twig' %}

{% block title %}Mon Portefeuille{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8">
    <!-- En-tête avec solde principal -->
    <div class="mb-8">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-3xl font-bold text-gray-900">Mon Portefeuille</h1>
            <a href="{{ path('app_wallet_payout_request') }}" 
               class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg transition-colors inline-flex items-center">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                Demander un retrait
            </a>
        </div>

        <!-- Cartes de solde -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <!-- Solde disponible -->
            <div class="bg-gradient-to-br from-green-500 to-green-600 text-white p-6 rounded-xl shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-green-100 text-sm font-medium">Solde Disponible</p>
                        <p class="text-3xl font-bold">{{ wallet.balance|number_format(2, ',', ' ') }} €</p>
                    </div>
                    <div class="bg-green-400 bg-opacity-30 p-3 rounded-lg">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Solde en attente -->
            <div class="bg-gradient-to-br from-orange-500 to-orange-600 text-white p-6 rounded-xl shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-orange-100 text-sm font-medium">Solde en Attente</p>
                        <p class="text-3xl font-bold">{{ wallet.pendingBalance|number_format(2, ',', ' ') }} €</p>
                    </div>
                    <div class="bg-orange-400 bg-opacity-30 p-3 rounded-lg">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Total des gains -->
            <div class="bg-gradient-to-br from-blue-500 to-blue-600 text-white p-6 rounded-xl shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-blue-100 text-sm font-medium">Total des Gains</p>
                        <p class="text-3xl font-bold">{{ wallet.totalEarnings|number_format(2, ',', ' ') }} €</p>
                    </div>
                    <div class="bg-blue-400 bg-opacity-30 p-3 rounded-lg">
                        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Statistiques mensuelles -->
        <div class="bg-white rounded-xl shadow-lg p-6">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-semibold text-gray-900">Statistiques du Mois</h2>
                <a href="{{ path('app_wallet_stats') }}" class="text-blue-600 hover:text-blue-700 text-sm font-medium">
                    Voir détails →
                </a>
            </div>

            <div class="space-y-4">
                <div class="flex items-center justify-between p-3 bg-green-50 rounded-lg">
                    <div class="flex items-center">
                        <div class="w-3 h-3 bg-green-500 rounded-full mr-3"></div>
                        <span class="text-gray-700">Revenus</span>
                    </div>
                    <span class="font-semibold text-green-600">+{{ monthlyStats.total_credits|number_format(2, ',', ' ') }} €</span>
                </div>

                <div class="flex items-center justify-between p-3 bg-red-50 rounded-lg">
                    <div class="flex items-center">
                        <div class="w-3 h-3 bg-red-500 rounded-full mr-3"></div>
                        <span class="text-gray-700">Retraits</span>
                    </div>
                    <span class="font-semibold text-red-600">-{{ monthlyStats.total_debits|number_format(2, ',', ' ') }} €</span>
                </div>

                <div class="border-t pt-3">
                    <div class="flex items-center justify-between">
                        <span class="font-medium text-gray-900">Net ce mois</span>
                        <span class="font-bold text-xl {{ monthlyStats.net_amount|number_format(2, '.', '') >= 0 ? 'text-green-600' : 'text-red-600' }}">
                            {{ monthlyStats.net_amount|number_format(2, ',', ' ') }} €
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dernières transactions -->
        <div class="bg-white rounded-xl shadow-lg p-6">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-semibold text-gray-900">Dernières Transactions</h2>
                <a href="{{ path('app_wallet_transactions') }}" class="text-blue-600 hover:text-blue-700 text-sm font-medium">
                    Voir tout →
                </a>
            </div>

            {% if transactions is empty %}
                <div class="text-center py-8">
                    <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                        </svg>
                    </div>
                    <p class="text-gray-500">Aucune transaction pour le moment</p>
                </div>
            {% else %}
                <div class="space-y-3">
                    {% for transaction in transactions %}
                        <div class="flex items-center justify-between p-3 border border-gray-100 rounded-lg hover:bg-gray-50 transition-colors">
                            <div class="flex items-center">
                                <div class="w-10 h-10 rounded-full flex items-center justify-center mr-3 
                                    {{ transaction.isCredit ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-600' }}">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        {% if transaction.isCredit %}
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                        {% else %}
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                                        {% endif %}
                                    </svg>
                                </div>
                                <div>
                                    <p class="font-medium text-gray-900">{{ transaction.sourceLabel }}</p>
                                    <p class="text-sm text-gray-500">{{ transaction.createdAt|date('d/m/Y H:i') }}</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="font-semibold {{ transaction.isCredit ? 'text-green-600' : 'text-red-600' }}">
                                    {{ transaction.isCredit ? '+' : '-' }}{{ transaction.amount|number_format(2, ',', ' ') }} €
                                </p>
                                {% if transaction.description %}
                                    <p class="text-xs text-gray-400">{{ transaction.description|slice(0, 30) }}...</p>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Demandes de retrait en cours -->
    {% if payoutRequests is not empty %}
        <div class="mt-8 bg-white rounded-xl shadow-lg p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-6">Demandes de Retrait</h2>
            
            <div class="overflow-x-auto">
                <table class="min-w-full">
                    <thead>
                        <tr class="border-b border-gray-200">
                            <th class="text-left py-3 px-4 font-medium text-gray-700">Date</th>
                            <th class="text-left py-3 px-4 font-medium text-gray-700">Montant</th>
                            <th class="text-left py-3 px-4 font-medium text-gray-700">Statut</th>
                            <th class="text-left py-3 px-4 font-medium text-gray-700">IBAN</th>
                            <th class="text-right py-3 px-4 font-medium text-gray-700">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for payoutRequest in payoutRequests %}
                            <tr class="border-b border-gray-100 hover:bg-gray-50">
                                <td class="py-3 px-4 text-gray-900">
                                    {{ payoutRequest.requestedAt|date('d/m/Y H:i') }}
                                </td>
                                <td class="py-3 px-4 font-semibold text-gray-900">
                                    {{ payoutRequest.amount|number_format(2, ',', ' ') }} €
                                </td>
                                <td class="py-3 px-4">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium
                                        {% if payoutRequest.status == 'pending' %}
                                            bg-yellow-100 text-yellow-800
                                        {% elseif payoutRequest.status == 'processing' %}
                                            bg-blue-100 text-blue-800
                                        {% elseif payoutRequest.status == 'completed' %}
                                            bg-green-100 text-green-800
                                        {% elseif payoutRequest.status == 'failed' %}
                                            bg-red-100 text-red-800
                                        {% else %}
                                            bg-gray-100 text-gray-800
                                        {% endif %}">
                                        {{ payoutRequest.statusLabel }}
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-gray-700 font-mono text-sm">
                                    {{ payoutRequest.iban[:4] }}****{{ payoutRequest.iban[-4:] }}
                                </td>
                                <td class="py-3 px-4 text-right">
                                    {% if payoutRequest.canBeCancelled %}
                                        <form method="post" action="{{ path('app_wallet_payout_cancel', {id: payoutRequest.id}) }}" 
                                              class="inline-block" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler cette demande ?')">
                                            <button type="submit" class="text-red-600 hover:text-red-800 text-sm font-medium">
                                                Annuler
                                            </button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
