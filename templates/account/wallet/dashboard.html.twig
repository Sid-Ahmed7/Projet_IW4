{% extends 'account/layout.html.twig' %}

{% block title %}Mon Portefeuille{% endblock %}

{% block content %}
	<div class="bg-gradient-to-br from-purple-100 via-pink-50 to-orange-100 -mx-6 -my-6 p-6 min-h-screen">
		<!-- En-tête avec solde principal -->
		<div class="mb-8">
			<div class="flex flex-col lg:flex-row lg:items-center lg:justify-between mb-8">
				<div class="mb-4 lg:mb-0">
					<div class="flex items-center mb-3">
						<div class="w-12 h-12 bg-gradient-to-br from-purple-500 via-pink-500 to-orange-500 rounded-2xl flex items-center justify-center shadow-lg mr-4 animate-pulse">
							<svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
							</svg>
						</div>
						<div>
							<h1 class="text-4xl font-bold bg-gradient-to-r from-purple-600 via-pink-600 to-orange-600 bg-clip-text text-transparent">Mon Portefeuille</h1>
							<p class="text-gray-700 text-lg font-medium">Gérez vos gains et demandez vos retraits en toute sécurité</p>
						</div>
					</div>
				</div>
				<div class="flex flex-col sm:flex-row gap-3">
					<a href="{{ path('app_wallet_transactions') }}" class="bg-gradient-to-r from-indigo-100 to-purple-100 hover:from-indigo-200 hover:to-purple-200 text-indigo-700 hover:text-indigo-800 px-6 py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl inline-flex items-center border-2 border-indigo-200/50">
						<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
						</svg>
						Historique
					</a>
					<a href="{{ path('app_wallet_payout_request') }}" class="bg-gradient-to-r from-pink-500 via-purple-600 to-indigo-600 hover:from-pink-600 hover:via-purple-700 hover:to-indigo-700 text-white px-8 py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 shadow-xl hover:shadow-2xl inline-flex items-center">
						<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
						</svg>
						Demander un retrait
					</a>
				</div>
			</div>

			<!-- Cartes de solde avec plus de couleurs -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
				<!-- Solde disponible -->
				<div class="group relative bg-gradient-to-br from-green-400 via-emerald-500 to-teal-600 text-white p-8 rounded-3xl shadow-2xl hover:shadow-3xl transition-all duration-500 transform hover:-translate-y-2 hover:rotate-1 cursor-pointer overflow-hidden">
					<div class="absolute inset-0 bg-gradient-to-br from-yellow-300/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
					<div class="absolute -top-4 -right-4 w-24 h-24 bg-yellow-300/20 rounded-full blur-xl group-hover:scale-150 transition-transform duration-500"></div>
					<div class="absolute -bottom-4 -left-4 w-16 h-16 bg-green-300/30 rounded-full blur-lg group-hover:scale-125 transition-transform duration-500"></div>
					<div class="relative z-10">
						<div class="flex items-center justify-between mb-6">
							<div class="bg-green-300/30 p-4 rounded-2xl backdrop-blur-sm group-hover:scale-110 transition-transform duration-300">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
								</svg>
							</div>
							<div class="text-green-100 text-xs font-bold uppercase tracking-widest bg-green-300/30 px-3 py-1 rounded-full backdrop-blur-sm">💰 Disponible</div>
						</div>
						<div class="text-5xl font-black mb-2 group-hover:scale-105 transition-transform duration-300">{{ wallet.balance|number_format(2, ',', ' ') }}€</div>
						<div class="text-green-100 text-sm font-medium">✨ Prêt pour retrait immédiat</div>
					</div>
				</div>

				<!-- Solde en attente -->
				<div class="group relative bg-gradient-to-br from-orange-400 via-red-500 to-pink-600 text-white p-8 rounded-3xl shadow-2xl hover:shadow-3xl transition-all duration-500 transform hover:-translate-y-2 hover:-rotate-1 cursor-pointer overflow-hidden">
					<div class="absolute inset-0 bg-gradient-to-br from-yellow-300/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
					<div class="absolute -top-4 -right-4 w-24 h-24 bg-yellow-300/20 rounded-full blur-xl group-hover:scale-150 transition-transform duration-500"></div>
					<div class="absolute -bottom-4 -left-4 w-16 h-16 bg-orange-300/30 rounded-full blur-lg group-hover:scale-125 transition-transform duration-500"></div>
					<div class="relative z-10">
						<div class="flex items-center justify-between mb-6">
							<div class="bg-orange-300/30 p-4 rounded-2xl backdrop-blur-sm group-hover:scale-110 transition-transform duration-300">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
							</div>
							<div class="text-orange-100 text-xs font-bold uppercase tracking-widest bg-orange-300/30 px-3 py-1 rounded-full backdrop-blur-sm">⏳ En attente</div>
						</div>
						<div class="text-5xl font-black mb-2 group-hover:scale-105 transition-transform duration-300">{{ wallet.pendingBalance|number_format(2, ',', ' ') }}€</div>
						<div class="text-orange-100 text-sm font-medium">🔄 En cours de traitement</div>
					</div>
				</div>

				<!-- Total des gains -->
				<div class="group relative bg-gradient-to-br from-blue-500 via-indigo-600 to-purple-700 text-white p-8 rounded-3xl shadow-2xl hover:shadow-3xl transition-all duration-500 transform hover:-translate-y-2 hover:rotate-1 cursor-pointer overflow-hidden">
					<div class="absolute inset-0 bg-gradient-to-br from-cyan-300/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
					<div class="absolute -top-4 -right-4 w-24 h-24 bg-cyan-300/20 rounded-full blur-xl group-hover:scale-150 transition-transform duration-500"></div>
					<div class="absolute -bottom-4 -left-4 w-16 h-16 bg-blue-300/30 rounded-full blur-lg group-hover:scale-125 transition-transform duration-500"></div>
					<div class="relative z-10">
						<div class="flex items-center justify-between mb-6">
							<div class="bg-blue-300/30 p-4 rounded-2xl backdrop-blur-sm group-hover:scale-110 transition-transform duration-300">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
								</svg>
							</div>
							<div class="text-indigo-100 text-xs font-bold uppercase tracking-widest bg-indigo-300/30 px-3 py-1 rounded-full backdrop-blur-sm">🏆 Total gains</div>
						</div>
						<div class="text-5xl font-black mb-2 group-hover:scale-105 transition-transform duration-300">{{ wallet.totalEarnings|number_format(2, ',', ' ') }}€</div>
						<div class="text-indigo-100 text-sm font-medium">📈 Depuis le début</div>
					</div>
				</div>
			</div>
		</div>

		<div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
			<!-- Statistiques mensuelles - span 2 colonnes -->
			<div class="xl:col-span-2 bg-gradient-to-br from-white to-blue-50/50 backdrop-blur-xl rounded-3xl shadow-2xl border border-blue-100/50 p-8 hover:shadow-3xl transition-all duration-300">
				<div class="flex items-center justify-between mb-8">
					<div class="flex items-center">
						<div class="w-14 h-14 bg-gradient-to-br from-cyan-400 via-blue-500 to-indigo-600 rounded-2xl flex items-center justify-center shadow-xl mr-4">
							<svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
							</svg>
						</div>
						<div>
							<h2 class="text-3xl font-bold bg-gradient-to-r from-cyan-600 via-blue-600 to-indigo-700 bg-clip-text text-transparent">Statistiques du Mois</h2>
							<p class="text-gray-700 font-medium">Aperçu de vos performances mensuelles</p>
						</div>
					</div>
					<a href="{{ path('app_wallet_stats') }}" class="bg-gradient-to-r from-blue-100 to-indigo-100 hover:from-blue-200 hover:to-indigo-200 text-blue-700 hover:text-blue-800 px-6 py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 shadow-md hover:shadow-lg border border-blue-200/50">
						📊 Voir détails →
					</a>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
					<!-- Revenus du mois -->
					<div class="group bg-gradient-to-br from-green-100 via-emerald-100 to-teal-100 p-8 rounded-2xl border-2 border-green-300/50 hover:border-green-400/70 transition-all duration-300 transform hover:-translate-y-1 hover:shadow-xl">
						<div class="flex items-center justify-between mb-6">
							<div class="w-16 h-16 bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11l5-5m0 0l5 5m-5-5v12"></path>
								</svg>
							</div>
							<span class="text-green-800 text-xs font-bold uppercase tracking-widest bg-green-300/80 px-3 py-2 rounded-full border border-green-400/50">💰 Revenus</span>
						</div>
						<div class="text-3xl font-black text-green-800 mb-2 group-hover:scale-105 transition-transform duration-300">+{{ monthlyStats.total_credits|number_format(2, ',', ' ') }}€</div>
						<div class="text-green-700 font-semibold">📈 Ce mois-ci</div>
					</div>

					<!-- Retraits du mois -->
					<div class="group bg-gradient-to-br from-orange-100 via-red-100 to-pink-100 p-8 rounded-2xl border-2 border-orange-300/50 hover:border-orange-400/70 transition-all duration-300 transform hover:-translate-y-1 hover:shadow-xl">
						<div class="flex items-center justify-between mb-6">
							<div class="w-16 h-16 bg-gradient-to-br from-orange-500 to-red-500 rounded-2xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 13l-5 5m0 0l-5-5m5 5V6"></path>
								</svg>
							</div>
							<span class="text-orange-800 text-xs font-bold uppercase tracking-widest bg-orange-300/80 px-3 py-2 rounded-full border border-orange-400/50">💸 Retraits</span>
						</div>
						<div class="text-3xl font-black text-orange-800 mb-2 group-hover:scale-105 transition-transform duration-300">-{{ monthlyStats.total_debits|number_format(2, ',', ' ') }}€</div>
						<div class="text-orange-700 font-semibold">📉 Ce mois-ci</div>
					</div>

					<!-- Bénéfice net -->
					<div class="group bg-gradient-to-br from-blue-100 via-indigo-100 to-purple-100 p-8 rounded-2xl border-2 border-blue-300/50 hover:border-blue-400/70 transition-all duration-300 transform hover:-translate-y-1 hover:shadow-xl">
						<div class="flex items-center justify-between mb-6">
							<div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-2xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
								<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
								</svg>
							</div>
							<span class="text-blue-800 text-xs font-bold uppercase tracking-widest bg-blue-300/80 px-3 py-2 rounded-full border border-blue-400/50">🏆 Net</span>
						</div>
						<div class="text-3xl font-black {{ monthlyStats.net_amount|number_format(2, '.', '') >= 0 ? 'text-blue-800' : 'text-red-800' }} mb-2 group-hover:scale-105 transition-transform duration-300">
							{{ monthlyStats.net_amount|number_format(2, ',', ' ') }}€
						</div>
						<div class="text-blue-700 font-semibold">💎 Bénéfice net</div>
					</div>
				</div>

				<!-- Actions rapides redesignées -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<a href="{{ path('app_wallet_transactions') }}" class="group bg-gradient-to-r from-gray-100 to-slate-100 hover:from-indigo-100 hover:to-blue-100 p-6 rounded-2xl border-2 border-gray-300/50 hover:border-indigo-300/70 transition-all duration-300 transform hover:-translate-y-1 hover:shadow-xl">
						<div class="flex items-center justify-between">
							<div class="flex items-center">
								<div class="w-14 h-14 bg-gradient-to-br from-indigo-500 to-blue-600 rounded-2xl flex items-center justify-center mr-4 group-hover:scale-110 transition-transform duration-300 shadow-lg">
									<svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
									</svg>
								</div>
								<div>
									<div class="font-bold text-xl text-gray-900 mb-1">📋 Historique complet</div>
									<div class="text-gray-700 font-medium">Voir toutes les transactions</div>
								</div>
							</div>
							<svg class="w-6 h-6 text-indigo-400 group-hover:text-indigo-600 group-hover:translate-x-1 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</div>
					</a>

					<a href="{{ path('app_wallet_stats') }}" class="group bg-gradient-to-r from-purple-100 to-pink-100 hover:from-purple-200 hover:to-pink-200 p-6 rounded-2xl border-2 border-purple-300/50 hover:border-purple-400/70 transition-all duration-300 transform hover:-translate-y-1 hover:shadow-xl">
						<div class="flex items-center justify-between">
							<div class="flex items-center">
								<div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-pink-600 rounded-2xl flex items-center justify-center mr-4 group-hover:scale-110 transition-transform duration-300 shadow-lg">
									<svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
									</svg>
								</div>
								<div>
									<div class="font-bold text-xl text-gray-900 mb-1">📊 Statistiques avancées</div>
									<div class="text-gray-700 font-medium">Analyses détaillées</div>
								</div>
							</div>
							<svg class="w-6 h-6 text-purple-400 group-hover:text-purple-600 group-hover:translate-x-1 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</div>
					</a>
				</div>
			</div>

			<!-- Dernières transactions redesignées -->
			<div class="bg-gradient-to-br from-white to-teal-50/50 backdrop-blur-xl rounded-3xl shadow-2xl border border-teal-100/50 p-8 hover:shadow-3xl transition-all duration-300">
				<div class="flex items-center justify-between mb-8">
					<div class="flex items-center">
						<div class="w-14 h-14 bg-gradient-to-br from-teal-500 to-cyan-600 rounded-2xl flex items-center justify-center shadow-lg mr-4">
							<svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
							</svg>
						</div>
						<div>
							<h2 class="text-2xl font-bold bg-gradient-to-r from-teal-600 to-cyan-700 bg-clip-text text-transparent">⚡ Activité Récente</h2>
							<p class="text-gray-700 font-medium">Dernières transactions</p>
						</div>
					</div>
					<a href="{{ path('app_wallet_transactions') }}" class="bg-gradient-to-r from-teal-100 to-cyan-100 hover:from-teal-200 hover:to-cyan-200 text-teal-700 hover:text-teal-800 px-6 py-3 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 shadow-md hover:shadow-lg border border-teal-200/50">
						🔍 Voir tout →
					</a>
				</div>

				{% if transactions is empty %}
					<div class="text-center py-16">
						<div class="w-28 h-28 bg-gradient-to-br from-yellow-100 via-orange-200 to-red-300 rounded-3xl flex items-center justify-center mx-auto mb-6 transform rotate-3 shadow-xl">
							<svg class="w-14 h-14 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
							</svg>
						</div>
						<h3 class="text-2xl font-bold bg-gradient-to-r from-orange-600 to-red-600 bg-clip-text text-transparent mb-3">🤷‍♂️ Aucune transaction</h3>
						<p class="text-gray-700 text-lg mb-6 font-medium">Vos transactions apparaîtront ici dès que vous commencerez à recevoir des paiements 🎉</p>
						<a href="{{ path('app_account_invoice_index') }}" class="bg-gradient-to-r from-green-500 via-teal-600 to-blue-600 hover:from-green-600 hover:via-teal-700 hover:to-blue-700 text-white px-8 py-4 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 shadow-xl hover:shadow-2xl inline-flex items-center">
							<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
							</svg>
							✨ Créer une facture
						</a>
					</div>
				{% else %}
					<div class="space-y-4">
						{% for transaction in transactions %}
							<div class="group relative bg-gradient-to-r from-white via-blue-50/30 to-white p-6 rounded-2xl border-2 border-blue-100/50 hover:border-blue-300/70 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
								<div class="flex items-center justify-between">
									<div class="flex items-center space-x-5">
										<div class="w-16 h-16 rounded-2xl flex items-center justify-center shadow-lg {{ transaction.isCredit ? 'bg-gradient-to-br from-green-400 via-emerald-500 to-teal-600' : 'bg-gradient-to-br from-orange-400 via-red-500 to-pink-600' }} group-hover:scale-110 transition-transform duration-300">
											<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												{% if transaction.isCredit %}
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11l5-5m0 0l5 5m-5-5v12"></path>
												{% else %}
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 13l-5 5m0 0l-5-5m5 5V6"></path>
												{% endif %}
											</svg>
										</div>
										<div class="flex-1">
											<p class="text-xl font-bold text-gray-900 mb-1">{{ transaction.sourceLabel }}</p>
											<p class="text-sm text-gray-500 font-medium">{{ transaction.createdAt|date('d/m/Y à H:i') }}</p>
											{% if transaction.description %}
												<p class="text-sm text-gray-400 mt-2 bg-gray-50 px-3 py-1 rounded-lg inline-block">{{ transaction.description|slice(0, 50) }}{% if transaction.description|length > 50 %}...{% endif %}</p>
											{% endif %}
										</div>
									</div>
									<div class="text-right">
										<p class="text-3xl font-black {{ transaction.isCredit ? 'text-green-700' : 'text-orange-700' }} group-hover:scale-105 transition-transform duration-300">
											{{ transaction.isCredit ? '💰 +' : '💸 -' }}{{ transaction.amount|number_format(2, ',', ' ') }}€
										</p>
										<div class="w-12 h-1 {{ transaction.isCredit ? 'bg-gradient-to-r from-green-400 to-emerald-500' : 'bg-gradient-to-r from-orange-400 to-red-500' }} rounded-full mt-2 ml-auto"></div>
									</div>
								</div>
							</div>
						{% endfor %}
					</div>
				{% endif %}
			</div>
		</div>

		<!-- Demandes de retrait en cours redesignées -->
		{% if payoutRequests is not empty %}
			<div class="mt-8 bg-gradient-to-br from-white to-violet-50/50 backdrop-blur-xl rounded-3xl shadow-2xl border border-violet-100/50 p-8 hover:shadow-3xl transition-all duration-300">
				<div class="flex items-center justify-between mb-8">
					<div class="flex items-center">
						<div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-pink-600 rounded-3xl flex items-center justify-center shadow-lg mr-4">
							<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
							</svg>
						</div>
						<div>
							<h2 class="text-3xl font-bold bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">💳 Demandes de Retrait</h2>
							<p class="text-gray-700 text-lg font-medium">Suivez l'état de vos demandes de retrait</p>
						</div>
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
					{% for payoutRequest in payoutRequests %}
						<div class="group bg-gradient-to-br from-white via-purple-50/30 to-white p-8 rounded-3xl border-2 border-purple-200/50 hover:border-purple-300/70 hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 hover:rotate-1">
							<div class="flex items-center justify-between mb-6">
								<div class="text-4xl font-black text-gray-900 group-hover:scale-105 transition-transform duration-300">
									💰 {{ payoutRequest.amount|number_format(2, ',', ' ') }}€
								</div>
								<span class="inline-flex items-center px-4 py-2 rounded-2xl text-sm font-bold border-2 transition-all duration-300
									{% if payoutRequest.status == 'pending' %}
										bg-gradient-to-r from-yellow-100 to-orange-100 text-yellow-800 border-yellow-400/50 group-hover:border-yellow-500">⏳ En attente
									{% elseif payoutRequest.status == 'processing' %}
										bg-gradient-to-r from-blue-100 to-indigo-100 text-blue-800 border-blue-400/50 group-hover:border-blue-500">🔄 En traitement
									{% elseif payoutRequest.status == 'completed' %}
										bg-gradient-to-r from-green-100 to-emerald-100 text-green-800 border-green-400/50 group-hover:border-green-500">✅ Terminé
									{% elseif payoutRequest.status == 'failed' %}
										bg-gradient-to-r from-red-100 to-pink-100 text-red-800 border-red-400/50 group-hover:border-red-500">❌ Échoué
									{% else %}
										bg-gradient-to-r from-gray-100 to-slate-100 text-gray-800 border-gray-400/50 group-hover:border-gray-500">❓ {{ payoutRequest.statusLabel }}
									{% endif %}
								</span>
							</div>

							<div class="space-y-4 mb-6">
								<div class="flex items-center text-gray-700 bg-gradient-to-r from-blue-50 to-indigo-50 px-4 py-3 rounded-2xl border border-blue-200/50">
									<svg class="w-5 h-5 mr-3 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
									</svg>
									<span class="font-semibold">📅 {{ payoutRequest.requestedAt|date('d/m/Y à H:i') }}</span>
								</div>
								{% if payoutRequest.accountHolderName %}
									<div class="flex items-center text-gray-700 bg-gradient-to-r from-green-50 to-emerald-50 px-4 py-3 rounded-2xl border border-green-200/50">
										<svg class="w-5 h-5 mr-3 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
										</svg>
										<span class="font-semibold">👤 {{ payoutRequest.accountHolderName }}</span>
									</div>
								{% endif %}
								<div class="flex items-center text-gray-700 bg-gradient-to-r from-purple-50 to-pink-50 px-4 py-3 rounded-2xl font-mono border border-purple-200/50">
									<svg class="w-5 h-5 mr-3 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
									</svg>
									<span class="font-bold">🏦 {{ payoutRequest.iban[:4] }}****{{ payoutRequest.iban[-4:] }}</span>
								</div>
							</div>

							{% if payoutRequest.canBeCancelled %}
								<form method="post" action="{{ path('app_wallet_payout_cancel', {id: payoutRequest.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler cette demande ?')">
									<button type="submit" class="w-full bg-gradient-to-r from-red-100 to-pink-100 hover:from-red-200 hover:to-pink-200 text-red-700 hover:text-red-800 px-6 py-4 rounded-2xl font-bold transition-all duration-300 border-2 border-red-300/50 hover:border-red-400/70 transform hover:scale-105 group-hover:shadow-lg">
										<svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
										</svg>
										🚫 Annuler la demande
									</button>
								</form>
							{% endif %}
						</div>
					{% endfor %}
				</div>
			</div>
		{% endif %}
	</div>
{% endblock %}
