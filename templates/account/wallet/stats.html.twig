{% extends 'base.html.twig' %}

{% block title %}Statistiques du Portefeuille{% endblock %}

{% block body %}
    {% include 'partials/admin/sidebare.html.twig' %}

    <main class="w-full md:w-[calc(100%-256px)] md:ml-64 bg-gray-100 min-h-screen transition-all main">
        <div class="p-6">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">Statistiques du Portefeuille</h1>
                    <p class="text-gray-600 mt-2">{{ company.name }} - {{ period == 'month' ? 'Ce mois' : (period == 'year' ? 'Cette année' : 'Cette semaine') }}</p>
                </div>
                <div class="flex items-center space-x-4">
                    <div class="flex items-center space-x-2 bg-white rounded-lg border border-gray-300 px-3 py-2">
                        <label class="text-sm font-medium text-gray-700">Période:</label>
                        <select id="periodSelect" class="border-none bg-transparent text-sm font-medium text-gray-900 focus:outline-none" onchange="changePeriod()">
                            <option value="week" {{ period == 'week' ? 'selected' : '' }}>Cette semaine</option>
                            <option value="month" {{ period == 'month' ? 'selected' : '' }}>Ce mois</option>
                            <option value="year" {{ period == 'year' ? 'selected' : '' }}>Cette année</option>
                        </select>
                    </div>
                    <a href="{{ path('app_wallet_dashboard') }}" 
                       class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                        </svg>
                        Retour au dashboard
                    </a>
                </div>
            </div>

            <!-- Aperçu de la période -->
            <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm mb-8">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-gray-900">Aperçu de la période</h3>
                    <div class="text-sm text-gray-500">
                        Du {{ startDate|date('d/m/Y') }} au {{ endDate|date('d/m/Y') }}
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Total Crédits -->
                    <div class="text-center p-4 bg-green-50 rounded-lg">
                        <div class="text-3xl font-bold text-green-600 mb-2">+{{ stats.total_credits|number_format(2, ',', ' ') }}€</div>
                        <div class="text-sm text-green-700 font-medium">Total des crédits</div>
                    </div>

                    <!-- Total Débits -->
                    <div class="text-center p-4 bg-red-50 rounded-lg">
                        <div class="text-3xl font-bold text-red-600 mb-2">-{{ stats.total_debits|number_format(2, ',', ' ') }}€</div>
                        <div class="text-sm text-red-700 font-medium">Total des débits</div>
                    </div>

                    <!-- Montant Net -->
                    <div class="text-center p-4 bg-blue-50 rounded-lg">
                        <div class="text-3xl font-bold text-blue-600 mb-2">{{ stats.net_amount|number_format(2, ',', ' ') }}€</div>
                        <div class="text-sm text-blue-700 font-medium">Montant net</div>
                    </div>
                </div>
            </div>

            <!-- Détails des transactions -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                <!-- Répartition par type -->
                <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
                    <h3 class="text-lg font-semibold text-gray-900 mb-6">Répartition par type de transaction</h3>
                    <div class="space-y-4">
                        {% for stat in stats.transaction_stats %}
                            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                                <div class="flex items-center">
                                    <div class="w-3 h-3 {{ stat.type == 'credit' ? 'bg-green-500' : 'bg-red-500' }} rounded-full mr-3"></div>
                                    <div>
                                        <div class="font-medium text-gray-900">
                                            {% if stat.source == 'invoice_payment' %}
                                                Paiement de facture
                                            {% elseif stat.source == 'payout_request' %}
                                                Demande de retrait
                                            {% else %}
                                                {{ stat.source|title }}
                                            {% endif %}
                                        </div>
                                        <div class="text-sm text-gray-500">{{ stat.count }} transaction{{ stat.count > 1 ? 's' : '' }}</div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="font-bold text-lg {{ stat.type == 'credit' ? 'text-green-600' : 'text-red-600' }}">
                                        {{ stat.type == 'credit' ? '+' : '-' }}{{ stat.total|number_format(2, ',', ' ') }}€
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="text-center py-8 text-gray-500">
                                <svg class="w-12 h-12 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                                <p>Aucune transaction pour cette période</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <!-- Comparaison avec la période précédente -->
                <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
                    <h3 class="text-lg font-semibold text-gray-900 mb-6">Évolution</h3>
                    <div class="space-y-6">
                        <!-- Crédits -->
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center mr-4">
                                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2"></path>
                                    </svg>
                                </div>
                                <div>
                                    <div class="font-medium text-gray-900">Revenus</div>
                                    <div class="text-sm text-gray-500">{{ period == 'month' ? 'Ce mois' : (period == 'year' ? 'Cette année' : 'Cette semaine') }}</div>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="font-bold text-lg text-green-600">{{ stats.total_credits|number_format(2, ',', ' ') }}€</div>
                                <div class="text-sm text-green-500">{{ stats.total_credits > 0 ? '+' : '' }}{{ stats.total_credits|number_format(0, ',', ' ') }}€</div>
                            </div>
                        </div>

                        <!-- Débits -->
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center mr-4">
                                    <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"></path>
                                    </svg>
                                </div>
                                <div>
                                    <div class="font-medium text-gray-900">Retraits</div>
                                    <div class="text-sm text-gray-500">{{ period == 'month' ? 'Ce mois' : (period == 'year' ? 'Cette année' : 'Cette semaine') }}</div>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="font-bold text-lg text-red-600">{{ stats.total_debits|number_format(2, ',', ' ') }}€</div>
                                <div class="text-sm text-gray-500">{{ stats.total_debits > 0 ? '+' : '' }}{{ stats.total_debits|number_format(0, ',', ' ') }}€</div>
                            </div>
                        </div>

                        <!-- Net -->
                        <div class="flex items-center justify-between pt-4 border-t border-gray-200">
                            <div class="flex items-center">
                                <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center mr-4">
                                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                                    </svg>
                                </div>
                                <div>
                                    <div class="font-medium text-gray-900">Bénéfice net</div>
                                    <div class="text-sm text-gray-500">Total de la période</div>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="font-bold text-xl text-blue-600">{{ stats.net_amount|number_format(2, ',', ' ') }}€</div>
                                <div class="text-sm {{ stats.net_amount > 0 ? 'text-green-500' : 'text-red-500' }}">
                                    {{ stats.net_amount > 0 ? 'Positif' : 'Négatif' }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900 mb-2">Actions rapides</h3>
                        <p class="text-gray-600">Gérez votre portefeuille efficacement</p>
                    </div>
                    <div class="flex items-center space-x-4">
                        <a href="{{ path('app_wallet_transactions') }}" 
                           class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                            Historique complet
                        </a>
                        <a href="{{ path('app_wallet_payout_request') }}" 
                           class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                            </svg>
                            Demander un retrait
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        function changePeriod() {
            const select = document.getElementById('periodSelect');
            const period = select.value;
            const currentUrl = new URL(window.location);
            currentUrl.searchParams.set('period', period);
            window.location.href = currentUrl.toString();
        }
    </script>
{% endblock %}
