{% extends 'base.html.twig' %}

{% block title %}Demander un retrait{% endblock %}

{% block body %}
    {% include 'partials/admin/sidebare.html.twig' %}

    <main class="w-full md:w-[calc(100%-256px)] md:ml-64 bg-gray-100 min-h-screen transition-all main">
        <div class="p-6">
            <div class="flex items-center justify-between mb-8">
                <div class="flex items-center">
                    <a href="{{ path('app_wallet_dashboard') }}" 
                       class="mr-4 p-2 rounded-md border border-gray-300 bg-white hover:bg-gray-50">
                        <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                        </svg>
                    </a>
                    <div>
                        <h1 class="text-3xl font-bold text-gray-900">Demander un retrait</h1>
                        <p class="text-gray-600 mt-2">{{ company.name }} - Transférez vos gains vers votre compte bancaire</p>
                    </div>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="{{ path('app_wallet_transactions') }}" 
                       class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                        Historique
                    </a>
                    <a href="{{ path('app_wallet_stats') }}" 
                       class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                        Statistiques
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Formulaire de demande -->
                <div class="lg:col-span-2">
                    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
                        <div class="mb-6">
                            <div class="flex items-center mb-3">
                                <div class="p-2 bg-blue-100 rounded-lg mr-3">
                                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                    </svg>
                                </div>
                                <h2 class="text-xl font-semibold text-gray-900">Informations de retrait</h2>
                            </div>
                            <p class="text-gray-600">Veuillez remplir les informations bancaires pour le virement</p>
                        </div>

                        {% if errors is defined and errors is not empty %}
                            <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
                                <div class="flex">
                                    <div class="flex-shrink-0">
                                        <svg class="h-5 w-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                    </div>
                                    <div class="ml-3">
                                        <h3 class="text-sm font-medium text-red-800">Erreurs détectées :</h3>
                                        <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                                            {% for error in errors %}
                                                <li>{{ error }}</li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        <form method="POST" class="space-y-6">
                            
                            <!-- Montant à retirer -->
                            <div>
                                <div class="flex items-center mb-2">
                                    <svg class="w-4 h-4 text-orange-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                                    </svg>
                                    <label for="amount" class="text-sm font-medium text-gray-700">Montant à retirer</label>
                                </div>
                                <div class="relative">
                                    <input type="number" 
                                           id="amount" 
                                           name="amount" 
                                           step="0.01" 
                                           min="10" 
                                           max="{{ wallet.balance }}"
                                           value="{{ form_data.amount ?? '' }}"
                                           class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-lg font-semibold pr-8" 
                                           placeholder="0,00" 
                                           required>
                                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                        <span class="text-gray-500 text-lg">€</span>
                                    </div>
                                </div>
                                <p class="text-sm text-gray-500 mt-1">
                                    Montant minimum : 10,00 € | Disponible : {{ wallet.balance|number_format(2, ',', ' ') }} €
                                </p>
                            </div>

                            <!-- Informations bancaires -->
                            <div class="border-t border-gray-200 pt-6">
                                <div class="flex items-center mb-4">
                                    <div class="p-2 bg-green-100 rounded-lg mr-3">
                                        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                        </svg>
                                    </div>
                                    <h3 class="text-lg font-semibold text-gray-900">Informations bancaires</h3>
                                </div>

                                <div class="grid grid-cols-1 gap-6">
                                    <!-- Nom du titulaire -->
                                    <div>
                                        <label for="account_holder_name" class="block text-sm font-medium text-gray-700 mb-2">Nom du titulaire du compte</label>
                                        <input type="text" 
                                               id="account_holder_name" 
                                               name="account_holder_name" 
                                               value="{{ form_data.account_holder_name ?? '' }}"
                                               class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" 
                                               required>
                                    </div>

                                    <!-- IBAN et BIC/SWIFT -->
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                        <div>
                                            <label for="iban" class="block text-sm font-medium text-gray-700 mb-2">IBAN</label>
                                            <input type="text" 
                                                   id="iban" 
                                                   name="iban" 
                                                   value="{{ form_data.iban ?? '' }}"
                                                   class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 font-mono text-sm" 
                                                   placeholder="FR14 2004 1010 0505 0001 3M02 606" 
                                                   required>
                                        </div>
                                        <div>
                                            <label for="bic" class="block text-sm font-medium text-gray-700 mb-2">BIC/SWIFT</label>
                                            <input type="text" 
                                                   id="bic" 
                                                   name="bic" 
                                                   value="{{ form_data.bic ?? '' }}"
                                                   class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 font-mono text-sm" 
                                                   placeholder="CCBPFRPPXXX" 
                                                   required>
                                        </div>
                                    </div>

                                    <!-- Notes optionnelles -->
                                    <div>
                                        <div class="flex items-center mb-2">
                                            <svg class="w-4 h-4 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-1l-4 4z"></path>
                                            </svg>
                                            <label for="notes" class="text-sm font-medium text-gray-700">Notes (optionnel)</label>
                                        </div>
                                        <textarea id="notes" 
                                                  name="notes" 
                                                  rows="3" 
                                                  class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" 
                                                  placeholder="Ajoutez des informations complémentaires...">{{ form_data.notes ?? '' }}</textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Boutons d'action -->
                            <div class="border-t border-gray-200 pt-6">
                                <div class="flex space-x-4">
                                    <button type="submit" 
                                            class="flex-1 inline-flex justify-center items-center px-6 py-3 border border-transparent rounded-md shadow-sm text-base font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                                        </svg>
                                        Envoyer la demande
                                    </button>
                                    <a href="{{ path('app_wallet_dashboard') }}" 
                                       class="flex-1 inline-flex justify-center items-center px-6 py-3 border border-gray-300 rounded-md shadow-sm text-base font-medium text-gray-700 bg-white hover:bg-gray-50">
                                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                        </svg>
                                        Annuler
                                    </a>
                                </div>
                            </div>

                        </form>
                    </div>
                </div>

                <!-- Sidebar avec informations -->
                <div class="space-y-6">
                    <!-- Récapitulatif du wallet -->
                    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
                        <div class="flex items-center mb-4">
                            <div class="p-2 bg-purple-100 rounded-lg mr-3">
                                <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                </svg>
                            </div>
                            <h3 class="text-lg font-semibold text-gray-900">Votre portefeuille</h3>
                        </div>
                        <div class="space-y-4">
                            <div class="flex justify-between items-center p-3 bg-green-50 rounded-lg">
                                <span class="text-sm font-medium text-gray-700">Solde disponible</span>
                                <span class="text-xl font-bold text-green-600">{{ wallet.balance|number_format(2, ',', ' ') }} €</span>
                            </div>
                            <div class="flex justify-between items-center p-3 bg-orange-50 rounded-lg">
                                <span class="text-sm font-medium text-gray-700">En attente</span>
                                <span class="text-lg font-semibold text-orange-600">{{ wallet.pendingBalance|number_format(2, ',', ' ') }} €</span>
                            </div>
                            <div class="flex justify-between items-center p-3 bg-blue-50 rounded-lg">
                                <span class="text-sm font-medium text-gray-700">Total des gains</span>
                                <span class="text-lg font-semibold text-blue-600">{{ (wallet.balance + wallet.pendingBalance)|number_format(2, ',', ' ') }} €</span>
                            </div>
                        </div>
                    </div>

                    <!-- Informations importantes -->
                    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
                        <div class="flex items-center mb-3">
                            <div class="p-1 bg-blue-100 rounded mr-2">
                                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <h3 class="text-base font-semibold text-blue-900">Informations importantes</h3>
                        </div>
                        <ul class="text-sm text-blue-800 space-y-2">
                            <li class="flex items-center">
                                <div class="w-1.5 h-1.5 bg-blue-600 rounded-full mr-3"></div>
                                <span>Montant minimum : 10,00 €</span>
                            </li>
                            <li class="flex items-center">
                                <div class="w-1.5 h-1.5 bg-blue-600 rounded-full mr-3"></div>
                                <span>Délai de traitement : 2-3 jours ouvrés</span>
                            </li>
                            <li class="flex items-center">
                                <div class="w-1.5 h-1.5 bg-blue-600 rounded-full mr-3"></div>
                                <span>Aucuns frais de virement</span>
                            </li>
                            <li class="flex items-center">
                                <div class="w-1.5 h-1.5 bg-blue-600 rounded-full mr-3"></div>
                                <span>Notification par email à chaque étape</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Historique des demandes -->
                    {% if payoutRequests is defined and payoutRequests is not empty %}
                        <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
                            <div class="flex items-center mb-4">
                                <div class="p-2 bg-gray-100 rounded-lg mr-3">
                                    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                </div>
                                <h3 class="text-lg font-semibold text-gray-900">Demandes récentes</h3>
                            </div>
                            <div class="space-y-3">
                                {% for request in payoutRequests|slice(0, 3) %}
                                    <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                                        <div class="flex items-center">
                                            <div class="w-2 h-2 {{ request.status == 'pending' ? 'bg-yellow-400' : (request.status == 'completed' ? 'bg-green-400' : 'bg-red-400') }} rounded-full mr-3"></div>
                                            <div>
                                                <div class="text-sm font-medium text-gray-900">{{ request.amount|number_format(2, ',', ' ') }} €</div>
                                                <div class="text-xs text-gray-500">{{ request.createdAt|date('d/m/Y') }}</div>
                                            </div>
                                        </div>
                                        <span class="text-xs px-2 py-1 rounded-full {{ request.status == 'pending' ? 'bg-yellow-100 text-yellow-800' : (request.status == 'completed' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800') }}">
                                            {{ request.status == 'pending' ? 'En attente' : (request.status == 'completed' ? 'Terminé' : 'Refusé') }}
                                        </span>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </main>
{% endblock %}
