{% extends 'layouts/app.html.twig' %}

{% block title %}Demander un retrait{% endblock %}

{% block content %}
<div class="bg-gradient-to-br from-blue-50 to-indigo-100 -mx-6 -my-8 p-8 min-h-screen">
    <!-- En-tête -->
        <div class="mb-8">
            <div class="flex items-center mb-6">
                <a href="{{ path('app_wallet_dashboard') }}" 
                   class="mr-4 p-2 rounded-lg bg-white shadow-md hover:shadow-lg transition-shadow">
                    <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                </a>
                <div>
                    <h1 class="text-3xl font-bold text-gray-900 mb-2">💸 Demander un retrait</h1>
                    <p class="text-gray-600">Transférez vos gains vers votre compte bancaire</p>
                </div>
            </div>
        </div>

        <div class="max-w-4xl mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

                <!-- Formulaire de demande -->
                <div class="lg:col-span-2">
                    <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-xl border border-white/20 p-8">
                        <div class="mb-8">
                            <h2 class="text-2xl font-bold text-gray-900 mb-2">Informations de retrait</h2>
                            <p class="text-gray-600">Veuillez remplir les informations bancaires pour le virement</p>
                        </div>

                        {% if errors is defined and errors is not empty %}
                            <div class="mb-6 bg-red-50 border-l-4 border-red-400 p-4 rounded-lg">
                                <div class="flex">
                                    <div class="flex-shrink-0">
                                        <svg class="h-5 w-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                    </div>
                                    <div class="ml-3">
                                        <h3 class="text-sm font-medium text-red-800">Erreurs détectées :</h3>
                                        <ul class="mt-2 text-sm text-red-700 list-disc list-inside">
                                            {% for error in errors %}
                                                <li>{{ error }}</li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        <form method="post" class="space-y-6">
                            <!-- Montant -->
                            <div>
                                <label for="amount" class="block text-sm font-semibold text-gray-900 mb-2">
                                    💰 Montant à retirer
                                </label>
                                <div class="relative">
                                    <input type="number" 
                                           id="amount" 
                                           name="amount" 
                                           step="0.01" 
                                           min="10" 
                                           max="{{ wallet.balance }}"
                                           value="{{ form_data.amount ?? '' }}"
                                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-lg font-semibold"
                                           placeholder="0,00"
                                           required>
                                    <div class="absolute inset-y-0 right-0 pr-4 flex items-center">
                                        <span class="text-gray-500 font-semibold">€</span>
                                    </div>
                                </div>
                                <p class="mt-2 text-sm text-gray-600">
                                    Montant minimum : 10,00 € | Disponible : <span class="font-semibold text-green-600">{{ wallet.balance|number_format(2, ',', ' ') }} €</span>
                                </p>
                            </div>

                            <!-- Informations bancaires -->
                            <div class="bg-gray-50 p-6 rounded-xl border border-gray-200">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">🏦 Informations bancaires</h3>
                                
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <!-- Nom du titulaire -->
                                    <div class="md:col-span-2">
                                        <label for="account_holder_name" class="block text-sm font-medium text-gray-700 mb-2">
                                            Nom du titulaire du compte
                                        </label>
                                        <input type="text" 
                                               id="account_holder_name" 
                                               name="account_holder_name" 
                                               value="{{ form_data.account_holder_name ?? company.name }}"
                                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                               placeholder="Nom complet ou raison sociale"
                                               required>
                                    </div>

                                    <!-- IBAN -->
                                    <div>
                                        <label for="iban" class="block text-sm font-medium text-gray-700 mb-2">
                                            IBAN
                                        </label>
                                        <input type="text" 
                                               id="iban" 
                                               name="iban" 
                                               value="{{ form_data.iban ?? company.iban ?? '' }}"
                                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono"
                                               placeholder="FR14 2004 1010 0505 0001 3M02 606"
                                               maxlength="34"
                                               required>
                                    </div>

                                    <!-- BIC -->
                                    <div>
                                        <label for="bic" class="block text-sm font-medium text-gray-700 mb-2">
                                            BIC/SWIFT
                                        </label>
                                        <input type="text" 
                                               id="bic" 
                                               name="bic" 
                                               value="{{ form_data.bic ?? company.bic ?? '' }}"
                                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono"
                                               placeholder="CCBPFRPPXXX"
                                               maxlength="11"
                                               required>
                                    </div>
                                </div>
                            </div>

                            <!-- Notes (optionnel) -->
                            <div>
                                <label for="notes" class="block text-sm font-medium text-gray-700 mb-2">
                                    📝 Notes (optionnel)
                                </label>
                                <textarea id="notes" 
                                          name="notes" 
                                          rows="3"
                                          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                          placeholder="Ajoutez des informations complémentaires...">{{ form_data.notes ?? '' }}</textarea>
                            </div>

                            <!-- Actions -->
                            <div class="flex flex-col sm:flex-row gap-4 pt-6">
                                <button type="submit" 
                                        class="flex-1 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white px-8 py-4 rounded-xl font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl">
                                    <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                                    </svg>
                                    Envoyer la demande
                                </button>
                                <a href="{{ path('app_wallet_dashboard') }}" 
                                   class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 px-8 py-4 rounded-xl font-semibold transition-colors text-center">
                                    Annuler
                                </a>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Informations et récapitulatif -->
                <div class="space-y-6">
                    <!-- Récapitulatif du wallet -->
                    <div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-xl border border-white/20 p-6">
                        <h3 class="text-lg font-bold text-gray-900 mb-4">💼 Votre portefeuille</h3>
                        <div class="space-y-4">
                            <div class="flex justify-between items-center p-3 bg-green-50 rounded-lg">
                                <span class="text-gray-700 font-medium">Solde disponible</span>
                                <span class="text-xl font-bold text-green-600">{{ wallet.balance|number_format(2, ',', ' ') }} €</span>
                            </div>
                            <div class="flex justify-between items-center p-3 bg-orange-50 rounded-lg">
                                <span class="text-gray-700 font-medium">En attente</span>
                                <span class="text-lg font-semibold text-orange-600">{{ wallet.pendingBalance|number_format(2, ',', ' ') }} €</span>
                            </div>
                            <div class="flex justify-between items-center p-3 bg-blue-50 rounded-lg">
                                <span class="text-gray-700 font-medium">Total des gains</span>
                                <span class="text-lg font-semibold text-blue-600">{{ wallet.totalEarnings|number_format(2, ',', ' ') }} €</span>
                            </div>
                        </div>
                    </div>

                    <!-- Informations importantes -->
                    <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
                        <div class="flex items-start">
                            <div class="flex-shrink-0">
                                <svg class="w-6 h-6 text-blue-600 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <div class="ml-3">
                                <h3 class="text-lg font-semibold text-blue-900 mb-2">ℹ️ Informations importantes</h3>
                                <ul class="text-sm text-blue-800 space-y-2">
                                    <li class="flex items-start">
                                        <span class="w-2 h-2 bg-blue-600 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                                        <span>Montant minimum : 10,00 €</span>
                                    </li>
                                    <li class="flex items-start">
                                        <span class="w-2 h-2 bg-blue-600 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                                        <span>Délai de traitement : 2-3 jours ouvrés</span>
                                    </li>
                                    <li class="flex items-start">
                                        <span class="w-2 h-2 bg-blue-600 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                                        <span>Aucuns frais de virement</span>
                                    </li>
                                    <li class="flex items-start">
                                        <span class="w-2 h-2 bg-blue-600 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                                        <span>Notification par email à chaque étape</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Sécurité -->
                    <div class="bg-green-50 border border-green-200 rounded-2xl p-6">
                        <div class="flex items-start">
                            <div class="flex-shrink-0">
                                <svg class="w-6 h-6 text-green-600 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                                </svg>
                            </div>
                            <div class="ml-3">
                                <h3 class="text-lg font-semibold text-green-900 mb-2">🔒 Sécurité</h3>
                                <p class="text-sm text-green-800">
                                    Tous les virements sont sécurisés et contrôlés. Vos informations bancaires sont chiffrées et protégées.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Formatage automatique de l'IBAN
document.getElementById('iban').addEventListener('input', function(e) {
    let value = e.target.value.replace(/\s/g, '').toUpperCase();
    let formattedValue = value.match(/.{1,4}/g)?.join(' ') || value;
    if (formattedValue !== e.target.value) {
        e.target.value = formattedValue;
    }
});

// Validation en temps réel du montant
document.getElementById('amount').addEventListener('input', function(e) {
    const maxAmount = {{ wallet.balance }};
    const value = parseFloat(e.target.value);
    
    if (value > maxAmount) {
        e.target.setCustomValidity('Le montant ne peut pas dépasser votre solde disponible');
    } else if (value < 10) {
        e.target.setCustomValidity('Le montant minimum est de 10,00 €');
    } else {
        e.target.setCustomValidity('');
    }
});
</script>
{% endblock %}
