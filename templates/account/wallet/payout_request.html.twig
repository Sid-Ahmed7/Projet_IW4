{% extends 'layouts/app.html.twig' %}

{% block title %}Demander un Retrait{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto">
        <!-- En-tête -->
        <div class="mb-8">
            <div class="flex items-center mb-4">
                <a href="{{ path('app_wallet_dashboard') }}" 
                   class="text-blue-600 hover:text-blue-700 inline-flex items-center mr-4">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Retour
                </a>
                <h1 class="text-3xl font-bold text-gray-900">Demander un Retrait</h1>
            </div>
            
            <!-- Information sur le solde disponible -->
            <div class="bg-blue-50 border border-blue-200 p-4 rounded-lg">
                <div class="flex items-center">
                    <svg class="w-5 h-5 text-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <div>
                        <p class="text-blue-900 font-medium">Solde disponible: {{ wallet.balance|number_format(2, ',', ' ') }} €</p>
                        <p class="text-blue-700 text-sm">Montant minimum de retrait: 10,00 €</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Formulaire de demande de retrait -->
        <div class="bg-white rounded-xl shadow-lg p-6">
            {% if errors is defined and errors is not empty %}
                <div class="mb-6 bg-red-50 border border-red-200 p-4 rounded-lg">
                    <div class="flex items-start">
                        <svg class="w-5 h-5 text-red-600 mr-3 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                        </svg>
                        <div>
                            <h3 class="text-red-900 font-medium">Erreurs dans le formulaire</h3>
                            <ul class="text-red-700 text-sm mt-1 list-disc list-inside">
                                {% for error in errors %}
                                    <li>{{ error }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
            {% endif %}

            <form method="post" class="space-y-6">
                <!-- Montant -->
                <div>
                    <label for="amount" class="block text-sm font-medium text-gray-700 mb-2">
                        Montant à retirer *
                    </label>
                    <div class="relative">
                        <input type="number" 
                               id="amount" 
                               name="amount" 
                               step="0.01" 
                               min="10" 
                               max="{{ wallet.balance }}"
                               value="{{ form_data.amount ?? '' }}"
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 pr-12" 
                               placeholder="10.00" 
                               required>
                        <div class="absolute inset-y-0 right-0 flex items-center pr-3">
                            <span class="text-gray-500 font-medium">€</span>
                        </div>
                    </div>
                    <p class="text-sm text-gray-500 mt-1">
                        Entre 10,00 € et {{ wallet.balance|number_format(2, ',', ' ') }} €
                    </p>
                </div>

                <!-- Informations bancaires -->
                <div class="border-t pt-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Informations Bancaires</h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- IBAN -->
                        <div class="md:col-span-2">
                            <label for="iban" class="block text-sm font-medium text-gray-700 mb-2">
                                IBAN *
                            </label>
                            <input type="text" 
                                   id="iban" 
                                   name="iban" 
                                   value="{{ form_data.iban ?? company.iban ?? '' }}"
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono" 
                                   placeholder="FR76 1234 5678 9012 3456 7890 123" 
                                   pattern="[A-Z]{2}[0-9]{2}[A-Z0-9]{1,30}"
                                   required>
                            <p class="text-sm text-gray-500 mt-1">Format: FR76 1234 5678 9012 3456 7890 123</p>
                        </div>

                        <!-- BIC -->
                        <div>
                            <label for="bic" class="block text-sm font-medium text-gray-700 mb-2">
                                BIC/SWIFT *
                            </label>
                            <input type="text" 
                                   id="bic" 
                                   name="bic" 
                                   value="{{ form_data.bic ?? company.bic ?? '' }}"
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono" 
                                   placeholder="BNPAFRPP" 
                                   pattern="[A-Z]{6}[A-Z2-9][A-NP-Z0-9]([A-Z0-9]{3})?"
                                   required>
                        </div>

                        <!-- Nom du titulaire -->
                        <div>
                            <label for="account_holder_name" class="block text-sm font-medium text-gray-700 mb-2">
                                Nom du titulaire *
                            </label>
                            <input type="text" 
                                   id="account_holder_name" 
                                   name="account_holder_name" 
                                   value="{{ form_data.account_holder_name ?? company.name ?? '' }}"
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" 
                                   placeholder="Nom sur le compte bancaire" 
                                   required>
                        </div>
                    </div>
                </div>

                <!-- Notes optionnelles -->
                <div>
                    <label for="notes" class="block text-sm font-medium text-gray-700 mb-2">
                        Notes (optionnel)
                    </label>
                    <textarea id="notes" 
                              name="notes" 
                              rows="3" 
                              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" 
                              placeholder="Informations complémentaires...">{{ form_data.notes ?? '' }}</textarea>
                </div>

                <!-- Informations sur le traitement -->
                <div class="bg-yellow-50 border border-yellow-200 p-4 rounded-lg">
                    <div class="flex items-start">
                        <svg class="w-5 h-5 text-yellow-600 mr-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 15.5c-.77.833.192 2.5 1.732 2.5z"></path>
                        </svg>
                        <div>
                            <h4 class="text-yellow-900 font-medium">Délais de traitement</h4>
                            <p class="text-yellow-700 text-sm mt-1">
                                Les demandes de retrait sont traitées sous 2-5 jours ouvrés. 
                                Vous recevrez un email de confirmation une fois le virement effectué.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Boutons -->
                <div class="flex justify-end space-x-4 pt-6">
                    <a href="{{ path('app_wallet_dashboard') }}" 
                       class="px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors">
                        Annuler
                    </a>
                    <button type="submit" 
                            class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium">
                        Créer la demande
                    </button>
                </div>
            </form>
        </div>

        <!-- Aide -->
        <div class="mt-8 bg-gray-50 border border-gray-200 p-4 rounded-lg">
            <h4 class="font-medium text-gray-900 mb-2">Besoin d'aide ?</h4>
            <p class="text-gray-600 text-sm">
                Si vous rencontrez des problèmes avec votre demande de retrait, 
                contactez notre support à l'adresse 
                <a href="mailto:support@factupro.com" class="text-blue-600 hover:text-blue-700">support@factupro.com</a>
            </p>
        </div>
    </div>
</div>

<script>
// Formatage automatique de l'IBAN
document.getElementById('iban').addEventListener('input', function(e) {
    let value = e.target.value.replace(/\s/g, '').toUpperCase();
    let formattedValue = value.replace(/(.{4})/g, '$1 ').trim();
    if (formattedValue !== e.target.value) {
        e.target.value = formattedValue;
    }
});

// Validation du montant en temps réel
document.getElementById('amount').addEventListener('input', function(e) {
    const value = parseFloat(e.target.value);
    const max = parseFloat(e.target.max);
    const min = parseFloat(e.target.min);
    
    if (value > max) {
        e.target.setCustomValidity(`Le montant ne peut pas dépasser ${max.toFixed(2)} €`);
    } else if (value < min) {
        e.target.setCustomValidity(`Le montant minimum est de ${min.toFixed(2)} €`);
    } else {
        e.target.setCustomValidity('');
    }
});
</script>
{% endblock %}
