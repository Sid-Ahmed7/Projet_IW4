{% extends 'account/layout.html.twig' %}

{% block title %}Mes devis{% endblock %}

{% block content %}
    <div class="bg-white shadow rounded-lg p-6">
        <div class="sm:flex sm:items-center">
            <div class="sm:flex-auto">
                <h1 class="text-2xl font-bold mb-6">Mes devis</h1>
            </div>
            {% if company is defined %}
                <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
                    <a href="{{ path('app_account_company_quote_new', {'companyId': company.id}) }}" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                        Nouveau devis
                    </a>
                </div>
            {% endif %}
        </div>

        <div class="mt-8 flow-root">
            <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
                <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
                    <table class="min-w-full divide-y divide-gray-300">
                        <thead>
                            <tr>
                                <th class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900">Numéro</th>
                                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Date</th>
                                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Montant</th>
                                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Statut</th>
                                <th class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                                    <span class="sr-only">Actions</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            {% for quote in quotes %}
                                <tr>
                                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900">{{ quote.number }}</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{ quote.createdAt|date('d/m/Y') }}</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{ quote.amount }} €</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                                        <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium
                                            {% if quote.status == 'accepted' %}
                                                bg-green-50 text-green-700 ring-1 ring-inset ring-green-600/20
                                            {% elseif quote.status == 'pending' %}
                                                bg-yellow-50 text-yellow-700 ring-1 ring-inset ring-yellow-600/20
                                            {% else %}
                                                bg-red-50 text-red-700 ring-1 ring-inset ring-red-600/20
                                            {% endif %}
                                        ">
                                            {{ quote.status }}
                                        </span>
                                    </td>
                                    <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                        {% if company is defined %}
                                            <a href="{{ path('app_account_company_quote_show', {'companyId': company.id, 'id': quote.id}) }}" class="text-blue-600 hover:text-blue-900">Voir</a>
                                        {% else %}
                                            <a href="{{ path('app_account_quote_show', {'id': quote.id}) }}" class="text-blue-600 hover:text-blue-900">Voir</a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-sm text-gray-500">Aucun devis trouvé</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %} 