{% extends "base.html.twig" %}

{% block title %}{{ message ?? 'Accès restreint' }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <div class="text-center">
            <svg class="mx-auto h-24 w-24 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L4.732 18.5c-.77.833.192 2.5 1.732 2.5z"/>
            </svg>
            <h2 class="mt-6 text-3xl font-extrabold text-gray-900">
                {{ message ?? 'Accès restreint' }}
            </h2>
            <p class="mt-2 text-sm text-gray-600">
                {{ description ?? 'Vous n\'avez pas les permissions nécessaires pour accéder à cette page.' }}
            </p>
        </div>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
        <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
            <div class="space-y-6">
                <div class="bg-red-50 border border-red-200 rounded-md p-4">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                            </svg>
                        </div>
                        <div class="ml-3">
                            <h3 class="text-sm font-medium text-red-800">
                                Création d'organisation non autorisée
                            </h3>
                            <div class="mt-2 text-sm text-red-700">
                                <p>
                                    Pour créer une organisation, vous devez disposer d'un compte entreprise. 
                                    Les comptes personnels ne peuvent pas créer d'organisations.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col space-y-4">
                    <a href="{{ path('app_account') }}" 
                       class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                        Retour au tableau de bord
                    </a>
                    
                    <div class="text-center">
                        <span class="text-sm text-gray-500">ou</span>
                    </div>
                    
                    <a href="{{ path('app_register') }}" 
                       class="w-full flex justify-center py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                        Créer un compte entreprise
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
