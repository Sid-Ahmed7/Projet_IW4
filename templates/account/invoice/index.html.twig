{% extends 'account/layout.html.twig' %}

{% block title %}Mes factures{% endblock %}

{% block content %}
    <div class="bg-white shadow rounded-lg p-6">
        <div class="sm:flex sm:items-center">
            <div class="sm:flex-auto">
                <h1 class="text-2xl font-bold mb-6">Mes factures</h1>
            </div>
        </div>

        {# Filtres #}
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
                <label for="search" class="block text-sm font-medium text-gray-700">Rechercher</label>
                <div class="mt-1">
                    <input type="text" id="search" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" placeholder="Rechercher...">
                </div>
            </div>
            <div>
                <label for="dateStart" class="block text-sm font-medium text-gray-700">Date début</label>
                <div class="mt-1">
                    <input type="date" id="dateStart" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                </div>
            </div>
            <div>
                <label for="dateEnd" class="block text-sm font-medium text-gray-700">Date fin</label>
                <div class="mt-1">
                    <input type="date" id="dateEnd" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                </div>
            </div>
        </div>

        <div class="mt-8 flow-root">
            <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
                <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
                    <table class="min-w-full divide-y divide-gray-300">
                        <thead>
                            <tr>
                                <th class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900">Numéro</th>
                                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Date</th>
                                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
									{% if app.user.accountType == 'company' %}
										Client
									{% else %}
										Company
									{% endif %}
								</th>
                                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Montant</th>
                                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Statut</th>
                                <th class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                                    <span class="sr-only">Actions</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody id="invoiceTableBody" class="divide-y divide-gray-200">
                            {% for invoice in invoices %}
                                <tr data-date="{{ invoice.createdAt|date('Y-m-d') }}" data-client="{{ app.user.accountType == 'company' ? invoice.hubuser.email : (invoice.company ? invoice.company.name : '') }}" data-number="{{ invoice.id }}">
                                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900">{{ invoice.id }}</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{ invoice.createdAt|date('d/m/Y') }}</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
										{% if app.user.accountType == 'company' %}
											{{ invoice.hubuser ? invoice.hubuser.email : 'Client inconnu' }}
										{% else %}
											{{ invoice.company ? invoice.company.name : 'N/A' }}
										{% endif %}
									</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{ invoice.amount }} €</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                                        {{ invoice_status_badge(invoice.status) }}
                                    </td>
                                    <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                        <div class="flex items-center justify-end space-x-3">
                                            {# Bouton Voir - toujours disponible #}
                                            <a href="{{ path('app_invoice_show', {'id': invoice.id}) }}" class="text-blue-600 hover:text-blue-900">Voir</a>
                                            
                                            {# Bouton PDF - toujours disponible #}
                                            <a href="{{ path('app_invoice_pdf', {'id': invoice.id}) }}" class="text-blue-600 hover:text-blue-900">PDF</a>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="text-center py-12">
                                        <div class="flex flex-col items-center">
                                            <svg class="h-12 w-12 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                            </svg>
                                            <h3 class="text-sm font-medium text-gray-900 mb-2">Aucune facture trouvée</h3>
                                            <p class="text-sm text-gray-500 text-center">
                                                {% if app.user.accountType == 'company' %}
                                                    Les factures générées à partir de vos devis payés apparaîtront ici.
                                                {% else %}
                                                    Vos factures d'entreprises apparaîtront ici une fois générées.
                                                {% endif %}
                                            </p>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('search');
    const dateStartInput = document.getElementById('dateStart');
    const dateEndInput = document.getElementById('dateEnd');
    const rows = document.querySelectorAll('#invoiceTableBody tr[data-date]');

    function filterTable() {
        const searchTerm = searchInput.value.toLowerCase();
        const startDate = dateStartInput.value ? new Date(dateStartInput.value) : null;
        const endDate = dateEndInput.value ? new Date(dateEndInput.value) : null;

        rows.forEach(row => {
            const date = new Date(row.dataset.date);
            const client = row.dataset.client.toLowerCase();
            const number = row.dataset.number.toLowerCase();
            const matchesSearch = !searchTerm || 
                client.includes(searchTerm) || 
                number.includes(searchTerm);
            const matchesDate = (!startDate || date >= startDate) && 
                              (!endDate || date <= endDate);

            row.style.display = matchesSearch && matchesDate ? '' : 'none';
        });
    }

    searchInput.addEventListener('input', filterTable);
    dateStartInput.addEventListener('change', filterTable);
    dateEndInput.addEventListener('change', filterTable);
});
</script>
{% endblock %} 