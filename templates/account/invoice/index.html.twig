{% extends 'account/layout.html.twig' %}

{% block title %}Mes factures{% endblock %}

{% block content %}
    <div class="bg-white shadow rounded-lg p-6">
        <div class="sm:flex sm:items-center">
            <div class="sm:flex-auto">
                <h1 class="text-2xl font-bold mb-6">Mes factures</h1>
            </div>
            <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
                {% if devis is defined and devis|length > 0 %}
                    <div class="relative" x-data="{ open: false }">
                        <button @click="open = !open" type="button" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700">
                            <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                            </svg>
                            Nouvelle facture
                        </button>
                        <div x-show="open" @click.away="open = false" class="absolute right-0 z-10 mt-2 w-56 origin-top-right rounded-md bg-white shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none" role="menu">
                            <div class="py-1" role="none">
                                {% for devis in devis %}
                                    <a href="{{ path('app_invoice_new', {'id': devis.id}) }}" class="text-gray-700 block px-4 py-2 text-sm hover:bg-gray-100" role="menuitem">Devis #{{ devis.id }}</a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <button type="button" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-400 cursor-not-allowed" disabled title="Vous devez d'abord créer un devis">
                        <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                        </svg>
                        Nouvelle facture
                    </button>
                {% endif %}
            </div>
        </div>

        {# Filtres #}
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
                <label for="search" class="block text-sm font-medium text-gray-700">Rechercher</label>
                <div class="mt-1">
                    <input type="text" id="search" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" placeholder="Rechercher...">
                </div>
            </div>
            <div>
                <label for="dateStart" class="block text-sm font-medium text-gray-700">Date début</label>
                <div class="mt-1">
                    <input type="date" id="dateStart" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                </div>
            </div>
            <div>
                <label for="dateEnd" class="block text-sm font-medium text-gray-700">Date fin</label>
                <div class="mt-1">
                    <input type="date" id="dateEnd" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                </div>
            </div>
        </div>

        <div class="mt-8 flow-root">
            <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
                <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
                    <table class="min-w-full divide-y divide-gray-300">
                        <thead>
                            <tr>
                                <th class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900">Numéro</th>
                                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Date</th>
                                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Client</th>
                                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Montant</th>
                                <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Statut</th>
                                <th class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                                    <span class="sr-only">Actions</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody id="invoiceTableBody" class="divide-y divide-gray-200">
                            {% for invoice in invoices %}
                                <tr data-date="{{ invoice.createdAt|date('Y-m-d') }}" data-client="{{ invoice.company ? invoice.company.name : '' }}" data-number="{{ invoice.id }}">
                                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900">{{ invoice.id }}</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{ invoice.createdAt|date('d/m/Y') }}</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{ invoice.company ? invoice.company.name : 'N/A' }}</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{ invoice.amount }} €</td>
                                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                                        <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium
                                            {% if invoice.state == 'paid' %}
                                                bg-green-50 text-green-700 ring-1 ring-inset ring-green-600/20
                                            {% elseif invoice.state == 'pending' %}
                                                bg-yellow-50 text-yellow-700 ring-1 ring-inset ring-yellow-600/20
                                            {% else %}
                                                bg-red-50 text-red-700 ring-1 ring-inset ring-red-600/20
                                            {% endif %}
                                        ">
                                            {{ invoice.state }}
                                        </span>
                                    </td>
                                    <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                        <div class="flex items-center justify-end space-x-3">
                                            <button type="button" onclick="showInvoiceDrawer('{{ path('app_invoice_show', {'id': invoice.id}) }}')" class="text-blue-600 hover:text-blue-900">Voir</button>
                                            <a href="{{ path('app_invoice_edit', {'id': invoice.id}) }}" class="text-blue-600 hover:text-blue-900">Modifier</a>
                                            <a href="{{ path('app_invoice_pdf', {'id': invoice.id}) }}" class="text-blue-600 hover:text-blue-900">PDF</a>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-sm text-gray-500">Aucune facture trouvée</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    {# Drawer pour afficher les détails de la facture #}
    <div id="invoiceDrawer" class="fixed inset-0 overflow-hidden z-50 hidden" role="dialog" aria-modal="true">
        <div class="absolute inset-0 overflow-hidden">
            <div class="absolute inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" onclick="hideInvoiceDrawer()"></div>
            <div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10">
                <div class="pointer-events-auto relative w-screen max-w-2xl">
                    <div class="flex h-full flex-col overflow-y-scroll bg-white py-6 shadow-xl">
                        <div class="px-4 sm:px-6">
                            <div class="flex items-start justify-between">
                                <h2 class="text-lg font-medium text-gray-900" id="invoiceDrawerTitle">Détails de la facture</h2>
                                <div class="ml-3 flex h-7 items-center">
                                    <button type="button" onclick="hideInvoiceDrawer()" class="rounded-md bg-white text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                                        <span class="sr-only">Fermer</span>
                                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="relative mt-6 flex-1 px-4 sm:px-6">
                            <div id="invoiceDrawerContent" class="absolute inset-0 px-4 sm:px-6">
                                {# Le contenu sera chargé dynamiquement ici #}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('search');
    const dateStartInput = document.getElementById('dateStart');
    const dateEndInput = document.getElementById('dateEnd');
    const rows = document.querySelectorAll('#invoiceTableBody tr[data-date]');

    function filterTable() {
        const searchTerm = searchInput.value.toLowerCase();
        const startDate = dateStartInput.value ? new Date(dateStartInput.value) : null;
        const endDate = dateEndInput.value ? new Date(dateEndInput.value) : null;

        rows.forEach(row => {
            const date = new Date(row.dataset.date);
            const client = row.dataset.client.toLowerCase();
            const number = row.dataset.number.toLowerCase();
            const matchesSearch = !searchTerm || 
                client.includes(searchTerm) || 
                number.includes(searchTerm);
            const matchesDate = (!startDate || date >= startDate) && 
                              (!endDate || date <= endDate);

            row.style.display = matchesSearch && matchesDate ? '' : 'none';
        });
    }

    searchInput.addEventListener('input', filterTable);
    dateStartInput.addEventListener('change', filterTable);
    dateEndInput.addEventListener('change', filterTable);
});

function showInvoiceDrawer(url) {
    const drawer = document.getElementById('invoiceDrawer');
    const content = document.getElementById('invoiceDrawerContent');
    
    // Afficher le drawer
    drawer.classList.remove('hidden');
    document.body.style.overflow = 'hidden'; // Empêcher le défilement de la page
    
    // Charger les détails de la facture
    fetch(url)
        .then(response => response.text())
        .then(html => {
            content.innerHTML = html;
        })
        .catch(error => {
            console.error('Erreur lors du chargement des détails:', error);
            content.innerHTML = 'Erreur lors du chargement des détails.';
        });
}

function hideInvoiceDrawer() {
    const drawer = document.getElementById('invoiceDrawer');
    const content = document.getElementById('invoiceDrawerContent');
    
    drawer.classList.add('hidden');
    document.body.style.overflow = ''; // Réactiver le défilement de la page
    content.innerHTML = '';
}

// Fermer le drawer avec la touche Escape
document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        hideInvoiceDrawer();
    }
});
</script>
{% endblock %} 