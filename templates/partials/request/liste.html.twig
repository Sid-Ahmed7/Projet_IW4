{% extends 'base.html.twig' %}

{% block title %}Liste des Demandes de Devis{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="mb-6">
            <h1 class="text-2xl font-bold">Liste des Demandes de Devis</h1>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full bg-white">
                <thead class="bg-gray-100">
                    <tr>
                        <th class="py-3 px-4 text-left">ID</th>
                        <th class="py-3 px-4 text-left">Client</th>
                        <th class="py-3 px-4 text-left">Email</th>
                        <th class="py-3 px-4 text-left">Type de service</th>
                        <th class="py-3 px-4 text-left">Date de livraison souhaitée</th>
                        <th class="py-3 px-4 text-left">Budget estimé</th>
                        <th class="py-3 px-4 text-left">Statut</th>
                        <th class="py-3 px-4 text-left">Date de création</th>
                        <th class="py-3 px-4 text-left">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for reque in reques %}
                        <tr class="border-t">
                            <td class="py-3 px-4">{{ reque.id }}</td>
                            <td class="py-3 px-4">{{ reque.firstname }}</td>
                            <td class="py-3 px-4">{{ reque.mail }}</td>
                            <td class="py-3 px-4">{{ reque.eventCountry }}</td>
                            <td class="py-3 px-4">{{ reque.eventdate ? reque.eventdate|date('d/m/Y') : '' }}</td>
                            <td class="py-3 px-4">{{ reque.maxBudget }} €</td>
                            <td class="py-3 px-4">
                                <span class="px-2 py-1 rounded-full text-sm
                                    {% if reque.state == 'en attente' %}
                                        bg-yellow-100 text-yellow-800
                                    {% elseif reque.state == 'approuvé' %}
                                        bg-green-100 text-green-800
                                    {% else %}
                                        bg-red-100 text-red-800
                                    {% endif %}">
                                    {{ reque.state }}
                                </span>
                            </td>
                            <td class="py-3 px-4">{{ reque.createdAt|date('d/m/Y H:i') }}</td>
                            <td class="py-3 px-4">
                                <div class="flex space-x-2">
                                    <a href="{{ path('app_reque_show', {'id': reque.id}) }}" 
                                       class="text-blue-500 hover:text-blue-700">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_reque_edit', {'id': reque.id}) }}" 
                                       class="text-green-500 hover:text-green-700">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form action="{{ path('app_reque_delete', {'id': reque.id}) }}" 
                                          method="post" 
                                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette demande de devis ?');"
                                          class="inline">
                                        <input type="hidden" name="_method" value="DELETE">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reque.id) }}">
                                        <button type="submit" class="text-red-500 hover:text-red-700">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="py-4 px-4 text-center text-gray-500">
                                Aucune demande de devis trouvée
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if reques|length > 0 %}
            <div class="mt-4">
                {{ knp_pagination_render(reques) }}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %} 