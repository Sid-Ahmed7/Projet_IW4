{% extends 'base.html.twig' %}

{% block title %}Inscription - FactuPro{% endblock %}

{% block body %}
<!-- Flatpickr CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

<!-- Tailwind CSS -->
<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">

<!-- Flatpickr JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<header class="border-gray-200 px-50 mb-10">
    <div class="container mx-auto flex flex-wrap items-center justify-between">
        <a href="{{ path('app_home_index') }}" class="flex">
            <svg class="h-10 w-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <span class="self-center text-lg font-semibold whitespace-nowrap ml-2">FactuPro</span>
        </a>
    </div>
</header>

<div class="container max-w-full mx-auto py-24 px-6">
    <div class="font-sans">
        <div class="max-w-sm mx-auto px-6">
            <div class="relative flex flex-wrap">
                <div class="w-full relative">
                    <div class="mt-6">
                        <div class="text-center font-semibold text-black text-xl mb-6">
                            Créer un compte
                        </div>

                        {% for message in app.flashes('error') %}
                            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                                <span class="block sm:inline">{{ message }}</span>
                            </div>
                        {% endfor %}

                        {% if not registrationForm.vars.valid %}
                            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
                                <span class="block sm:inline">Veuillez corriger les erreurs suivantes :</span>
                                <ul class="mt-2 list-disc list-inside">
                                    {% for error in registrationForm.vars.errors %}
                                        <li>{{ error.message }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}
                        
                        {{ form_start(registrationForm, {'attr': {'class': 'mt-8'}}) }}
                            <div class="mx-auto max-w-lg">
                                <div class="py-2">
                                    {{ form_label(registrationForm.accountType, 'Type de compte', {'label_attr': {'class': 'px-1 text-sm text-gray-600 font-semibold'}}) }}
                                    <div class="mt-2 space-y-2">
                                        {% for choice in registrationForm.accountType %}
                                            <div class="flex items-center">
                                                {{ form_widget(choice, {'attr': {'class': 'mr-2'}}) }}
                                                {{ form_label(choice, null, {'label_attr': {'class': 'text-sm text-gray-700'}}) }}
                                            </div>
                                        {% endfor %}
                                    </div>
                                    {{ form_errors(registrationForm.accountType) }}
                                </div>

                                <div class="py-2">
                                    {{ form_label(registrationForm.lastname, 'Nom', {'label_attr': {'class': 'px-1 text-sm text-gray-600'}}) }}
                                    {{ form_widget(registrationForm.lastname, {'attr': {
                                        'class': 'text-md block px-3 py-2 rounded-lg w-full bg-white border-2 border-gray-300 placeholder-gray-600 shadow-md focus:placeholder-gray-500 focus:bg-white focus:border-gray-600 focus:outline-none',
                                        'placeholder': 'Nom'
                                    }}) }}
                                    {{ form_errors(registrationForm.lastname) }}
                                </div>

                                <div class="py-2">
                                    {{ form_label(registrationForm.firstname, 'Prénom', {'label_attr': {'class': 'px-1 text-sm text-gray-600'}}) }}
                                    {{ form_widget(registrationForm.firstname, {'attr': {
                                        'class': 'text-md block px-3 py-2 rounded-lg w-full bg-white border-2 border-gray-300 placeholder-gray-600 shadow-md focus:placeholder-gray-500 focus:bg-white focus:border-gray-600 focus:outline-none',
                                        'placeholder': 'Prénom'
                                    }}) }}
                                    {{ form_errors(registrationForm.firstname) }}
                                </div>

                                <div class="py-2">
                                    {{ form_label(registrationForm.email, 'Email', {'label_attr': {'class': 'px-1 text-sm text-gray-600'}}) }}
                                    {{ form_widget(registrationForm.email, {'attr': {
                                        'class': 'text-md block px-3 py-2 rounded-lg w-full bg-white border-2 border-gray-300 placeholder-gray-600 shadow-md focus:placeholder-gray-500 focus:bg-white focus:border-gray-600 focus:outline-none',
                                        'placeholder': 'Votre email'
                                    }}) }}
                                    {{ form_errors(registrationForm.email) }}
                                </div>

                                <div class="py-2">
                                    {{ form_label(registrationForm.username, 'Nom d\'utilisateur', {'label_attr': {'class': 'px-1 text-sm text-gray-600'}}) }}
                                    {{ form_widget(registrationForm.username, {'attr': {
                                        'class': 'text-md block px-3 py-2 rounded-lg w-full bg-white border-2 border-gray-300 placeholder-gray-600 shadow-md focus:placeholder-gray-500 focus:bg-white focus:border-gray-600 focus:outline-none',
                                        'placeholder': 'Nom d\'utilisateur'
                                    }}) }}
                                    {{ form_errors(registrationForm.username) }}
                                </div>

                                <div class="py-2">
                                    {{ form_label(registrationForm.birthdate, 'Date de naissance', {'label_attr': {'class': 'px-1 text-sm text-gray-600'}}) }}
                                    {{ form_widget(registrationForm.birthdate, {'attr': {
                                        'class': 'text-md block px-3 py-2 rounded-lg w-full bg-white border-2 border-gray-300 placeholder-gray-600 shadow-md focus:placeholder-gray-500 focus:bg-white focus:border-gray-600 focus:outline-none',
                                        'placeholder': 'Date de naissance'
                                    }}) }}
                                    {{ form_errors(registrationForm.birthdate) }}
                                </div>

                                <div class="py-2">
                                    {{ form_label(registrationForm.password, 'Mot de passe', {'label_attr': {'class': 'px-1 text-sm text-gray-600'}}) }}
                                    {{ form_widget(registrationForm.password, {'attr': {
                                        'class': 'text-md block px-3 py-2 rounded-lg w-full bg-white border-2 border-gray-300 placeholder-gray-600 shadow-md focus:placeholder-gray-500 focus:bg-white focus:border-gray-600 focus:outline-none',
                                        'placeholder': 'Mot de passe'
                                    }}) }}
                                    {{ form_errors(registrationForm.password) }}
                                    <div class="mt-2 text-sm text-gray-600">
                                        <p class="font-semibold">Recommandations pour votre mot de passe :</p>
                                        <ul class="list-disc list-inside">
                                            <li>Au moins 8 caractères</li>
                                            <li>Au moins une lettre majuscule</li>
                                            <li>Au moins une lettre minuscule</li>
                                            <li>Au moins un chiffre</li>
                                            <li>Au moins un caractère spécial</li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="flex justify-between mt-4">
                                    {# <div class="flex items-center">
                                        <input type="checkbox" id="remember" class="leading-loose text-pink-600">
                                        <label for="remember" class="ml-2 text-sm text-gray-600">Se souvenir de moi</label>
                                    </div> #}
                                    <a href="{{ path('app_login') }}" class="text-sm text-blue-600 hover:text-blue-800">
                                        Déjà inscrit ? Connectez-vous
                                    </a>
                                </div>

                                <button type="submit" class="mt-3 text-lg font-semibold bg-blue-500 w-full text-white rounded-lg px-6 py-3 block shadow-xl hover:text-white hover:bg-black">
                                    S'inscrire
                                </button>
                            </div>
                        {{ form_end(registrationForm) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    flatpickr("#registration_form_birthdate", {
        dateFormat: "Y-m-d",
        maxDate: "today",
        locale: "fr"
    });
</script>
{% endblock %}

