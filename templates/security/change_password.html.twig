{% extends 'base.html.twig' %}

{% block title %}Changer le mot de passe{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h1 class="h3 mb-0">Changer le mot de passe</h1>
                    </div>
                    <div class="card-body">
                        {{ form_start(form) }}
                            {{ form_row(form.oldPassword) }}
                            {{ form_row(form.newPassword) }}
                            {{ form_row(form.confirmPassword) }}
                            
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary">Changer le mot de passe</button>
                                <a href="{{ path('app_account') }}" class="btn btn-secondary">Annuler</a>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %} 