{% extends 'emails/base.html.twig' %}

{% block content %}
    <div class="space-y-6">
        <!-- Titre principal -->
        <div class="text-center">
            <h2 class="text-3xl font-bold text-blue-600 mb-2">🧾 Nouvelle facture créée</h2>
            <div class="w-24 h-1 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto rounded-full"></div>
        </div>
        
        <!-- Message d'accueil -->
        <div class="text-gray-700">
            <p class="text-lg">Bonjour <span class="font-semibold text-blue-600">{{ user.firstname }} {{ user.lastname }}</span>,</p>
            <p class="mt-2">Une nouvelle facture a été générée pour votre entreprise <span class="font-semibold text-gray-900">{{ company.name }}</span>.</p>
        </div>
        
        <!-- Détails de la facture -->
        <div class="bg-gradient-to-r from-blue-50 to-purple-50 border-l-4 border-blue-500 rounded-r-lg p-6">
            <h3 class="text-xl font-semibold text-gray-900 mb-4 flex items-center">
                🧾 <span class="ml-2">Détails de la facture</span>
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-3">
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-20">Numéro:</span>
                        <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-semibold">{{ invoice.number }}</span>
                    </div>
                    {% if invoice.devis %}
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-20">Devis:</span>
                        <span class="text-gray-900 font-medium">#{{ invoice.devis.id }} - {{ invoice.devis.title }}</span>
                    </div>
                    {% endif %}
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-20">Montant:</span>
                        <span class="text-blue-600 font-bold text-lg">{{ invoice.amount|number_format(2, ',', ' ') }}€</span>
                    </div>
                </div>
                <div class="space-y-3">
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-16">Statut:</span>
                        <span class="bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-sm font-semibold uppercase">{{ invoice.status }}</span>
                    </div>
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-16">Créée le:</span>
                        <span class="text-gray-700">{{ invoice.createdAt|date('d/m/Y à H:i') }}</span>
                    </div>
                    {% if invoice.dueDate %}
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-16">Échéance:</span>
                        <span class="text-orange-600 font-medium">{{ invoice.dueDate|date('d/m/Y') }}</span>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
        
        <!-- Boutons d'action -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="{{ url('app_account_invoice_show', {id: invoice.id}) }}" 
               class="inline-flex items-center justify-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-lg transition-all duration-200 transform hover:scale-105">
                🧾 <span class="ml-2">Voir la facture</span>
            </a>
            <a href="{{ url('app_invoice_pdf', {id: invoice.id}) }}" 
               class="inline-flex items-center justify-center px-6 py-3 bg-gray-600 hover:bg-gray-700 text-white font-semibold rounded-lg shadow-lg transition-all duration-200 transform hover:scale-105">
                📄 <span class="ml-2">Télécharger PDF</span>
            </a>
        </div>
        
        <!-- Informations de paiement -->
        <div class="bg-green-50 border border-green-200 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-green-900 mb-3 flex items-center">
                💳 <span class="ml-2">Informations de paiement</span>
            </h3>
            <div class="text-green-700 space-y-2">
                <p>Vous pouvez procéder au paiement de cette facture en ligne de manière sécurisée.</p>
                <p class="font-medium">Plusieurs modes de paiement sont acceptés :</p>
                <ul class="list-disc list-inside ml-4 space-y-1">
                    <li>Carte bancaire (Visa, Mastercard)</li>
                    <li>Paiement en ligne sécurisé</li>
                    <li>Virement bancaire</li>
                </ul>
            </div>
        </div>
        
        <!-- Message de service -->
        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
            <p class="text-gray-700 text-center">
                Pour toute question concernant cette facture, n'hésitez pas à nous contacter.
            </p>
        </div>
        
        <!-- Signature -->
        <div class="text-right">
            <p class="text-gray-600">
                Cordialement,<br>
                <span class="font-semibold text-blue-600">L'équipe FactuPro</span>
            </p>
        </div>
    </div>
{% endblock %}
