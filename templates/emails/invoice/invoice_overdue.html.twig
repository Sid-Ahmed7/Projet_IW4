{% extends 'emails/base.html.twig' %}

{% block content %}
    <div class="space-y-6">
        <!-- Titre principal -->
        <div class="text-center">
            <h2 class="text-3xl font-bold text-red-600 mb-2">⚠️ Facture en retard</h2>
            <div class="w-24 h-1 bg-gradient-to-r from-red-500 to-orange-500 mx-auto rounded-full"></div>
        </div>
        
        <!-- Message d'alerte -->
        <div class="bg-gradient-to-r from-red-100 to-orange-100 border-2 border-red-300 rounded-xl p-6 text-center">
            <div class="text-4xl mb-2">🚨</div>
            <h3 class="text-xl font-bold text-red-800">Action requise</h3>
            <p class="text-red-700 mt-1">Votre facture est en retard de paiement</p>
        </div>
        
        <!-- Message d'accueil -->
        <div class="text-gray-700">
            <p class="text-lg">Bonjour <span class="font-semibold text-red-600">{{ user.firstname }} {{ user.lastname }}</span>,</p>
            <p class="mt-2">Nous vous informons que votre facture pour l'entreprise <span class="font-semibold text-gray-900">{{ company.name }}</span> est en retard de paiement.</p>
        </div>
        
        <!-- Détails de la facture en retard -->
        <div class="bg-gradient-to-r from-red-50 to-orange-50 border-l-4 border-red-500 rounded-r-lg p-6">
            <h3 class="text-xl font-semibold text-gray-900 mb-4 flex items-center">
                🧾 <span class="ml-2">Détails de la facture en retard</span>
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-3">
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-20">Numéro:</span>
                        <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm font-semibold">{{ invoice.number }}</span>
                    </div>
                    {% if invoice.devis %}
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-20">Devis:</span>
                        <span class="text-gray-900 font-medium">#{{ invoice.devis.id }} - {{ invoice.devis.title }}</span>
                    </div>
                    {% endif %}
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-20">Montant dû:</span>
                        <span class="text-red-600 font-bold text-lg">{{ invoice.amount|number_format(2, ',', ' ') }}€</span>
                    </div>
                </div>
                <div class="space-y-3">
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-16">Statut:</span>
                        <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm font-semibold uppercase">En retard</span>
                    </div>
                    {% if invoice.dueDate %}
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-16">Échéance:</span>
                        <span class="text-red-600 font-medium">{{ invoice.dueDate|date('d/m/Y') }}</span>
                    </div>
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-16">Retard:</span>
                        <span class="text-red-600 font-bold">{{ date().diff(invoice.dueDate).days }} jours</span>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
        
        <!-- Boutons d'action -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="{{ url('app_account_invoice_show', {id: invoice.id}) }}" 
               class="inline-flex items-center justify-center px-6 py-3 bg-gray-600 hover:bg-gray-700 text-white font-semibold rounded-lg shadow-lg transition-all duration-200 transform hover:scale-105">
                🧾 <span class="ml-2">Voir la facture</span>
            </a>
            <a href="{{ url('app_stripe_payment', {invoice: invoice.id}) }}" 
               class="inline-flex items-center justify-center px-6 py-3 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-lg shadow-lg transition-all duration-200 transform hover:scale-105 animate-pulse">
                💳 <span class="ml-2">Payer maintenant</span>
            </a>
        </div>
        
        <!-- Action requise -->
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-yellow-900 mb-3 flex items-center">
                ⚠️ <span class="ml-2">Action requise</span>
            </h3>
            <p class="text-yellow-800">
                Pour éviter tout désagrément et maintenir votre service, nous vous demandons de bien vouloir 
                régler cette facture dans les plus brefs délais.
            </p>
        </div>
        
        <!-- Options de paiement -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-blue-900 mb-3 flex items-center">
                💳 <span class="ml-2">Options de paiement</span>
            </h3>
            <ul class="space-y-3">
                <li class="flex items-start">
                    <div class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold mr-3 mt-0.5">💳</div>
                    <span class="text-blue-700">Paiement en ligne sécurisé par carte bancaire</span>
                </li>
                <li class="flex items-start">
                    <div class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold mr-3 mt-0.5">🏦</div>
                    <span class="text-blue-700">Virement bancaire (coordonnées disponibles sur la facture)</span>
                </li>
                <li class="flex items-start">
                    <div class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold mr-3 mt-0.5">📞</div>
                    <span class="text-blue-700">Contactez-nous pour un échéancier de paiement</span>
                </li>
            </ul>
        </div>
        
        <!-- Note importante -->
        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
            <p class="text-gray-700 text-center text-sm">
                Si vous avez déjà effectué le paiement, merci d'ignorer ce message ou de nous transmettre 
                votre justificatif de paiement.
            </p>
        </div>
        
        <!-- Contact -->
        <div class="bg-gradient-to-r from-blue-100 to-purple-100 p-4 rounded-lg border border-blue-200">
            <p class="text-blue-800 text-center">
                Pour toute question, n'hésitez pas à nous contacter.
            </p>
        </div>
        
        <!-- Signature -->
        <div class="text-right">
            <p class="text-gray-600">
                Cordialement,<br>
                <span class="font-semibold text-blue-600">L'équipe FactuPro</span>
            </p>
        </div>
    </div>
{% endblock %}
