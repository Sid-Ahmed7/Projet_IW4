{% extends 'emails/email_base.html.twig' %}

{% block content %}
    <div class="space-y-6">
        <!-- Titre principal -->
        <div class="text-center">
            <h2 class="text-3xl font-bold text-red-600 mb-2">❌ Devis refusé</h2>
            <div class="w-24 h-1 bg-gradient-to-r from-red-500 to-rose-500 mx-auto rounded-full"></div>
        </div>
        
        <!-- Message d'accueil -->
        <div class="text-gray-700">
            <p class="text-lg">Bonjour <span class="font-semibold text-red-600">{{ user.firstname }} {{ user.lastname }}</span>,</p>
            <p class="mt-2">Nous vous informons que le devis pour votre entreprise <span class="font-semibold text-gray-900">{{ company.name }}</span> a été refusé.</p>
        </div>
        
        <!-- Détails du devis -->
        <div class="bg-gradient-to-r from-red-50 to-rose-50 border-l-4 border-red-500 rounded-r-lg p-6">
            <h3 class="text-xl font-semibold text-gray-900 mb-4 flex items-center">
                📋 <span class="ml-2">Détails du devis</span>
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-3">
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-20">Numéro:</span>
                        <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm font-semibold">#{{ devis.id }}</span>
                    </div>
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-20">Titre:</span>
                        <span class="text-gray-900 font-medium">{{ devis.title }}</span>
                    </div>
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-20">Montant:</span>
                        <span class="text-gray-600 font-bold text-lg line-through">{{ devis.price|number_format(2, ',', ' ') }}€</span>
                    </div>
                </div>
                <div class="space-y-3">
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-16">Statut:</span>
                        <span class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm font-semibold uppercase">{{ devis.state }}</span>
                    </div>
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-16">Refusé le:</span>
                        <span class="text-gray-700">{{ devis.updatedAt|date('d/m/Y à H:i') }}</span>
                    </div>
                </div>
            </div>
            
            {% if reason %}
            <div class="mt-4 pt-4 border-t border-red-200">
                <span class="font-medium text-gray-600">Motif du refus:</span>
                <div class="mt-2 text-gray-700 bg-white p-3 rounded-lg border border-red-200">
                    {{ reason|nl2br }}
                </div>
            </div>
            {% endif %}
        </div>
        
        <!-- Bouton d'action -->
        <div class="text-center">
            <a href="{{ url('app_devis_show', {id: devis.id}) }}" 
               class="inline-flex items-center px-6 py-3 bg-gray-600 hover:bg-gray-700 text-white font-semibold rounded-lg shadow-lg transition-all duration-200 transform hover:scale-105">
                📄 <span class="ml-2">Voir le devis</span>
            </a>
        </div>
        
        <!-- Que faire maintenant -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-blue-900 mb-3 flex items-center">
                💡 <span class="ml-2">Que faire maintenant ?</span>
            </h3>
            <ul class="space-y-3">
                <li class="flex items-start">
                    <div class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold mr-3 mt-0.5">1</div>
                    <span class="text-blue-700">Vous pouvez modifier et soumettre un nouveau devis</span>
                </li>
                <li class="flex items-start">
                    <div class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold mr-3 mt-0.5">2</div>
                    <span class="text-blue-700">Contactez-nous pour discuter des ajustements possibles</span>
                </li>
                <li class="flex items-start">
                    <div class="flex-shrink-0 w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-sm font-semibold mr-3 mt-0.5">3</div>
                    <span class="text-blue-700">Consultez nos autres services disponibles</span>
                </li>
            </ul>
        </div>
        
        <!-- Message d'encouragement -->
        <div class="bg-gradient-to-r from-yellow-100 to-orange-100 p-4 rounded-lg border border-yellow-200">
            <p class="text-yellow-800 text-center">
                N'hésitez pas à nous contacter pour toute question ou pour discuter d'alternatives.
            </p>
        </div>
        
        <!-- Signature -->
        <div class="text-right">
            <p class="text-gray-600">
                Cordialement,<br>
                <span class="font-semibold text-blue-600">L'équipe FactuPro</span>
            </p>
        </div>
    </div>
{% endblock %}
