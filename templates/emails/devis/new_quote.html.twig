{% extends 'emails/email_base.html.twig' %}

{% block content %}
    <div class="space-y-6">
        <!-- Titre principal -->
        <div class="text-center">
            <h2 class="text-3xl font-bold text-gray-900 mb-2">🎉 Nouveau devis créé</h2>
            <div class="w-24 h-1 bg-gradient-to-r from-blue-500 to-green-500 mx-auto rounded-full"></div>
        </div>
        
        <!-- Message d'accueil -->
        <div class="text-gray-700">
            <p class="text-lg">Bonjour <span class="font-semibold text-blue-600">{{ user.firstname }} {{ user.lastname }}</span>,</p>
            <p class="mt-2">Un nouveau devis a été créé pour votre entreprise <span class="font-semibold text-gray-900">{{ company.name }}</span>.</p>
        </div>
        
        <!-- Détails du devis -->
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-l-4 border-blue-500 rounded-r-lg p-6">
            <h3 class="text-xl font-semibold text-gray-900 mb-4 flex items-center">
                📋 <span class="ml-2">Détails du devis</span>
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-3">
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-20">Numéro:</span>
                        <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-semibold">#{{ devis.id }}</span>
                    </div>
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-20">Titre:</span>
                        <span class="text-gray-900 font-medium">{{ devis.title }}</span>
                    </div>
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-20">Montant:</span>
                        <span class="text-green-600 font-bold text-lg">{{ devis.price|number_format(2, ',', ' ') }}€</span>
                    </div>
                </div>
                <div class="space-y-3">
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-16">Statut:</span>
                        <span class="bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-sm font-semibold uppercase">{{ devis.state }}</span>
                    </div>
                    <div class="flex items-center">
                        <span class="font-medium text-gray-600 w-16">Créé le:</span>
                        <span class="text-gray-700">{{ devis.createdAt|date('d/m/Y à H:i') }}</span>
                    </div>
                </div>
            </div>
            
            {% if devis.content %}
            <div class="mt-4 pt-4 border-t border-blue-200">
                <span class="font-medium text-gray-600">Description:</span>
                <div class="mt-2 text-gray-700 bg-white p-3 rounded-lg border border-blue-200">
                    {{ devis.content|nl2br }}
                </div>
            </div>
            {% endif %}
        </div>
        
        <!-- Bouton d'action -->
        <div class="text-center">
            <a href="{{ url('app_devis_show', {id: devis.id}) }}" 
               class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-lg transition-all duration-200 transform hover:scale-105">
                📄 <span class="ml-2">Voir le devis</span>
            </a>
        </div>
        
        <!-- Message de fin -->
        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
            <p class="text-gray-700">
                Vous pouvez maintenant examiner ce devis et prendre les actions nécessaires.
            </p>
        </div>
        
        <!-- Signature -->
        <div class="text-right">
            <p class="text-gray-600">
                Cordialement,<br>
                <span class="font-semibold text-blue-600">L'équipe FactuPro</span>
            </p>
        </div>
    </div>
{% endblock %}
