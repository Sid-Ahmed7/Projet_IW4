<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nouvelle demande de retrait - FactuPro Admin</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            margin: 0;
            padding: 0;
            background-color: #f8fafc;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 300;
        }
        .alert {
            background: #fef3c7;
            border-left: 4px solid #f59e0b;
            padding: 16px;
            margin: 20px;
            border-radius: 6px;
        }
        .alert-icon {
            font-size: 24px;
            margin-right: 10px;
        }
        .content {
            padding: 30px;
        }
        .company-info {
            background: #f1f5f9;
            padding: 20px;
            border-radius: 8px;
            margin: 20px 0;
        }
        .amount {
            font-size: 32px;
            font-weight: bold;
            color: #059669;
            text-align: center;
            margin: 20px 0;
        }
        .details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin: 20px 0;
        }
        .detail-item {
            background: #f8fafc;
            padding: 15px;
            border-radius: 6px;
            border-left: 3px solid #3b82f6;
        }
        .detail-label {
            font-size: 12px;
            color: #64748b;
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 5px;
        }
        .detail-value {
            font-size: 16px;
            color: #1e293b;
            font-weight: 500;
        }
        .bank-info {
            background: #fef7ff;
            border: 2px solid #e879f9;
            padding: 20px;
            border-radius: 8px;
            margin: 20px 0;
        }
        .bank-info h3 {
            color: #a21caf;
            margin-top: 0;
        }
        .action-button {
            display: block;
            width: 100%;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            text-decoration: none;
            padding: 16px 32px;
            border-radius: 8px;
            text-align: center;
            font-weight: 600;
            font-size: 16px;
            margin: 30px 0;
            box-shadow: 0 4px 6px rgba(16, 185, 129, 0.3);
        }
        .footer {
            background: #1e293b;
            color: #94a3b8;
            text-align: center;
            padding: 20px;
            font-size: 14px;
        }
        .priority {
            background: #fee2e2;
            border: 2px solid #fca5a5;
            padding: 15px;
            border-radius: 8px;
            margin: 20px 0;
            text-align: center;
        }
        .priority-icon {
            font-size: 20px;
            color: #dc2626;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>🔔 Nouvelle Demande de Retrait</h1>
            <p>Administration FactuPro</p>
        </div>

        <div class="content">
            <!-- Alert priorité -->
            <div class="priority">
                <span class="priority-icon">🚨</span>
                <strong>Action requise :</strong> Une nouvelle demande de retrait nécessite votre validation
            </div>

            <!-- Montant principal -->
            <div class="amount">
                {{ payoutRequest.amount|number_format(2, ',', ' ') }} €
            </div>

            <!-- Informations entreprise -->
            <div class="company-info">
                <h3>🏢 Entreprise : {{ company.name }}</h3>
                <p><strong>Demandé par :</strong> {{ requestedBy.firstname }} {{ requestedBy.lastname }}</p>
                <p><strong>Email :</strong> {{ requestedBy.email }}</p>
                <p><strong>Date :</strong> {{ payoutRequest.requestedAt|date('d/m/Y à H:i') }}</p>
            </div>

            <!-- Détails du wallet -->
            <div class="details-grid">
                <div class="detail-item">
                    <div class="detail-label">Solde wallet actuel</div>
                    <div class="detail-value">{{ wallet.balance|number_format(2, ',', ' ') }} €</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">ID Demande</div>
                    <div class="detail-value">#{{ payoutRequest.id }}</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Solde après retrait</div>
                    <div class="detail-value">{{ (wallet.balance - payoutRequest.amount)|number_format(2, ',', ' ') }} €</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Statut</div>
                    <div class="detail-value">🟡 En attente</div>
                </div>
            </div>

            <!-- Informations bancaires -->
            <div class="bank-info">
                <h3>💳 Informations bancaires</h3>
                <p><strong>Titulaire :</strong> {{ payoutRequest.accountHolderName }}</p>
                <p><strong>IBAN :</strong> <code>{{ payoutRequest.iban }}</code></p>
                <p><strong>BIC :</strong> <code>{{ payoutRequest.bic }}</code></p>
                {% if payoutRequest.notes %}
                    <p><strong>Notes :</strong> {{ payoutRequest.notes }}</p>
                {% endif %}
            </div>

            <!-- Bouton d'action -->
            <a href="{{ url('admin_payouts') }}" class="action-button">
                🚀 Traiter la demande maintenant
            </a>

            <!-- Instructions -->
            <div class="alert">
                <span class="alert-icon">ℹ️</span>
                <strong>Instructions :</strong> Connectez-vous à l'interface d'administration pour traiter cette demande. 
                Vous pouvez la traiter, la compléter ou la marquer comme échouée selon la situation.
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>FactuPro - Administration des Retraits</p>
            <p>Email envoyé automatiquement à {{ admin.email }}</p>
        </div>
    </div>
</body>
</html>
