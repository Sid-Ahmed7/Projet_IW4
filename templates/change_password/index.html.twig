{% extends 'base.html.twig' %}

{% block title %}Changer le mot de passe - Haze{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h1 class="h3 mb-0">Changer le mot de passe</h1>
                    </div>
                    <div class="card-body">
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger">
                                {{ message }}
                            </div>
                        {% endfor %}

                        {{ form_start(form) }}
                            <div class="mb-3">
                                {{ form_label(form.oldPassword, 'Mot de passe actuel', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.oldPassword, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.oldPassword) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.newPassword, 'Nouveau mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.newPassword, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.newPassword) }}
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary">Changer le mot de passe</button>
                                <a href="{{ path('app_account') }}" class="btn btn-secondary">Annuler</a>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %} 