{% extends 'base.html.twig' %}

{% block title %}Admin - Tableau de bord{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-8">Tableau de bord Admin</h1>
        
        <!-- Statistiques générales -->
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-5 mb-8">
            <!-- Total Utilisateurs -->
            <div class="bg-white overflow-hidden shadow rounded-lg">
                <div class="p-5">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="h-6 w-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-7.092C16.5 7.111 14 4.5 14 4.5s-2.5 2.611-2.5 6.5 2.5 6.5 2.5 6.5 2.5-2.611 2.5-6.5z"/>
                            </svg>
                        </div>
                        <div class="ml-5 w-0 flex-1">
                            <dl>
                                <dt class="text-sm font-medium text-gray-500 truncate">Utilisateurs</dt>
                                <dd class="text-2xl font-semibold text-gray-900">{{ users_count }}</dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="bg-blue-50 px-5 py-3">
                    <div class="text-sm">
                        <a href="{{ path('app_admin_users') }}" class="font-medium text-blue-700 hover:text-blue-900">Gérer les utilisateurs</a>
                    </div>
                </div>
            </div>

            <!-- Total Entreprises -->
            <div class="bg-white overflow-hidden shadow rounded-lg">
                <div class="p-5">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="h-6 w-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                            </svg>
                        </div>
                        <div class="ml-5 w-0 flex-1">
                            <dl>
                                <dt class="text-sm font-medium text-gray-500 truncate">Entreprises</dt>
                                <dd class="text-2xl font-semibold text-gray-900">{{ companies_count }}</dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="bg-green-50 px-5 py-3">
                    <div class="text-sm">
                        <a href="{{ path('app_company_index') }}" class="font-medium text-green-700 hover:text-green-900">Voir les entreprises</a>
                    </div>
                </div>
            </div>

            <!-- Total Devis -->
            <div class="bg-white overflow-hidden shadow rounded-lg">
                <div class="p-5">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="h-6 w-6 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                        </div>
                        <div class="ml-5 w-0 flex-1">
                            <dl>
                                <dt class="text-sm font-medium text-gray-500 truncate">Devis Total</dt>
                                <dd class="text-2xl font-semibold text-gray-900">{{ devis_count }}</dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="bg-yellow-50 px-5 py-3">
                    <div class="text-sm">
                        <a href="{{ path('app_devis_index') }}" class="font-medium text-yellow-700 hover:text-yellow-900">Voir tous les devis</a>
                    </div>
                </div>
            </div>

            <!-- Total Factures -->
            <div class="bg-white overflow-hidden shadow rounded-lg">
                <div class="p-5">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="h-6 w-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                        </div>
                        <div class="ml-5 w-0 flex-1">
                            <dl>
                                <dt class="text-sm font-medium text-gray-500 truncate">Factures Total</dt>
                                <dd class="text-2xl font-semibold text-gray-900">{{ invoices_count }}</dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="bg-purple-50 px-5 py-3">
                    <div class="text-sm">
                        <a href="{{ path('app_invoice_index') }}" class="font-medium text-purple-700 hover:text-purple-900">Voir toutes les factures</a>
                    </div>
                </div>
            </div>

            <!-- Retraits en attente -->
            <div class="bg-white overflow-hidden shadow rounded-lg">
                <div class="p-5">
                    <div class="flex items-center">
                        <div class="flex-shrink-0">
                            <svg class="h-6 w-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                        </div>
                        <div class="ml-5 w-0 flex-1">
                            <dl>
                                <dt class="text-sm font-medium text-gray-500 truncate">Retraits</dt>
                                <dd class="text-2xl font-semibold text-gray-900">
                                    <span class="text-red-600">{{ payouts_pending }}</span>
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="bg-red-50 px-5 py-3">
                    <div class="text-sm">
                        <a href="{{ path('admin_payouts') }}" class="font-medium text-red-700 hover:text-red-900">
                            {% if payouts_pending > 0 %}
                                🚨 {{ payouts_pending }} en attente
                            {% else %}
                                Gérer les retraits
                            {% endif %}
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Devis par statut -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            <div class="bg-white shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                    <h3 class="text-lg leading-6 font-medium text-gray-900">Devis par statut</h3>
                    <div class="mt-4 space-y-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-orange-400 rounded-full mr-3"></div>
                                <span class="text-sm text-gray-700">En attente</span>
                            </div>
                            <span class="text-sm font-semibold text-gray-900">{{ devis_en_attente }}</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-green-400 rounded-full mr-3"></div>
                                <span class="text-sm text-gray-700">Acceptés</span>
                            </div>
                            <span class="text-sm font-semibold text-gray-900">{{ devis_acceptes }}</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-red-400 rounded-full mr-3"></div>
                                <span class="text-sm text-gray-700">Refusés</span>
                            </div>
                            <span class="text-sm font-semibold text-gray-900">{{ devis_refuses }}</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-blue-400 rounded-full mr-3"></div>
                                <span class="text-sm text-gray-700">Finalisés (payés)</span>
                            </div>
                            <span class="text-sm font-semibold text-gray-900">{{ devis_finalises }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                    <h3 class="text-lg leading-6 font-medium text-gray-900">Factures par statut</h3>
                    <div class="mt-4 space-y-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-yellow-400 rounded-full mr-3"></div>
                                <span class="text-sm text-gray-700">En attente</span>
                            </div>
                            <span class="text-sm font-semibold text-gray-900">{{ factures_en_attente }}</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-green-400 rounded-full mr-3"></div>
                                <span class="text-sm text-gray-700">Payées</span>
                            </div>
                            <span class="text-sm font-semibold text-gray-900">{{ factures_payees }}</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-red-400 rounded-full mr-3"></div>
                                <span class="text-sm text-gray-700">Échues</span>
                            </div>
                            <span class="text-sm font-semibold text-gray-900">{{ factures_echues }}</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                    <h3 class="text-lg leading-6 font-medium text-gray-900">Retraits par statut</h3>
                    <div class="mt-4 space-y-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-yellow-400 rounded-full mr-3"></div>
                                <span class="text-sm text-gray-700">En attente</span>
                            </div>
                            <span class="text-sm font-semibold text-gray-900">{{ payouts_pending }}</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-blue-400 rounded-full mr-3"></div>
                                <span class="text-sm text-gray-700">En cours</span>
                            </div>
                            <span class="text-sm font-semibold text-gray-900">{{ payouts_processing }}</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-green-400 rounded-full mr-3"></div>
                                <span class="text-sm text-gray-700">Complétés</span>
                            </div>
                            <span class="text-sm font-semibold text-gray-900">{{ payouts_completed }}</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-red-400 rounded-full mr-3"></div>
                                <span class="text-sm text-gray-700">Échoués</span>
                            </div>
                            <span class="text-sm font-semibold text-gray-900">{{ payouts_failed }}</span>
                        </div>
                    </div>
                    <div class="mt-4 pt-4 border-t">
                        <a href="{{ path('admin_payouts') }}" 
                           class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                            Gérer les retraits
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Entreprises les plus actives -->
        <div class="bg-white shadow rounded-lg">
            <div class="px-4 py-5 sm:p-6">
                <h3 class="text-lg leading-6 font-medium text-gray-900">Entreprises les plus actives</h3>
                {% if top_companies is empty %}
                    <p class="text-sm text-gray-500 mt-4">Aucune entreprise avec des devis</p>
                {% else %}
                    <div class="mt-4 space-y-3">
                        {% for company in top_companies %}
                            <div class="flex items-center justify-between">
                                <div class="flex-1">
                                    <p class="text-sm font-medium text-gray-900">{{ company.name }}</p>
                                    <p class="text-sm text-gray-500">{{ company.devis_count }} devis - {{ company.total_amount|number_format(0, ',', ' ') }}€</p>
                                </div>
                                <div class="text-right">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                        {{ company.devis_count }} devis
                                    </span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
